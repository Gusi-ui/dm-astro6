{
  "name": "astro6dm",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "wrangler d1 migrations apply astro6dm-db",
    "db:create": "wrangler d1 create astro6dm-db",
    "db:local": "wrangler d1 execute astro6dm-db --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute astro6dm-db --remote --file=./migrations/0001_initial.sql",
    "setup:cloudflare": "./scripts/setup-cloudflare.sh",
    "deploy": "pnpm run deploy:pages",
    "deploy:pages": "pnpm build && wrangler pages deploy dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.1",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^6.4.4",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260606.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.20",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "wrangler": "^4.98.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
