{
  "name": "astro6dm",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "wrangler d1 migrations apply astro6dm-db",
    "db:create": "wrangler d1 create astro6dm-db",
    "db:local": "wrangler d1 execute astro6dm-db --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute astro6dm-db --remote --file=./migrations/0001_initial.sql",
    "setup:cloudflare": "./scripts/setup-cloudflare.sh",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:pages": "pnpm build && wrangler pages deploy dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^6.0.0-beta.0",
    "tailwindcss": "^3.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.3",
    "@cloudflare/workers-types": "^4.20241106.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.53.1",
    "wrangler": "^4.60.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
