{
  "name": "astro6dm",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "wrangler d1 migrations apply astro6dm-db",
    "db:create": "wrangler d1 create astro6dm-db",
    "db:local": "wrangler d1 execute astro6dm-db --local --file=./migrations/0001_initial.sql",
    "db:remote": "wrangler d1 execute astro6dm-db --remote --file=./migrations/0001_initial.sql",
    "setup:cloudflare": "./scripts/setup-cloudflare.sh",
    "deploy": "pnpm run deploy:worker",
    "deploy:worker": "pnpm build && wrangler deploy",
    "deploy:pages": "pnpm run deploy:worker",
    "upload:blog-images": "node scripts/upload-blog-images.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^7.2.2",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260920.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/hast": "^3.0.5",
    "@types/node": "^24.13.6",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.135.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
