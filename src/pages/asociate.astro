---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import AssociationForm from '../components/forms/AssociationForm.astro';
---

<BaseLayout
  title="Únete a Nosotros - Asociación Diversidad Funcional Mataró"
  description="Únete a nuestra asociación de forma gratuita. Trabajamos por una sociedad con accesibilidad universal."
>
  <Header />
  <main class="min-h-screen">
    <section class="bg-gradient-to-br from-primary-50 to-accent-50 py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-2xl">
          <h1 class="mb-4 text-center text-4xl font-bold text-gray-900 md:text-5xl">
            Únete a Nuestra Asociación
          </h1>
          <p class="mb-12 text-center text-lg text-gray-600">
            Completa el formulario para unirte a nuestra causa. <strong
              >Es completamente gratuito</strong
            > y no cobramos ningún tipo de cuota.
          </p>

          <div class="rounded-2xl bg-white p-8 shadow-xl md:p-12">
            <AssociationForm />
          </div>

          <div class="mt-8 text-center text-sm text-gray-600">
            <p>Al unirte, recibirás información sobre nuestras actividades y reivindicaciones.</p>
            <p class="mt-2">Nuestro principal medio de comunicación es WhatsApp.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
