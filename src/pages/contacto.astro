---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import HeroBackground from '../components/HeroBackground.astro';
import { getRandomHeroImage } from '../lib/heroImages';

const heroImage = getRandomHeroImage();
---

<BaseLayout title="Contacto - Diversidad Funcional Mataró">
  <Header />
  <main id="main-content">
    <!-- Hero Section -->
    <section
      class="relative flex min-h-[70vh] items-center justify-center overflow-hidden pt-16 md:min-h-[80vh] md:pt-20"
    >
      <!-- Fondo con imagen responsive -->
      <HeroBackground image={heroImage} />

      <!-- Iconos flotantes decorativos -->
      <div class="absolute left-10 top-32 z-10 hidden animate-float lg:block">
        <div
          class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg class="h-8 w-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </div>
      </div>

      <div class="absolute right-16 top-40 z-10 hidden animate-float-delay lg:block">
        <div
          class="flex h-20 w-20 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg
            class="h-10 w-10 text-orange-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
      </div>

      <!-- Contenido principal -->
      <div class="section-container relative z-20 py-20">
        <div class="mx-auto max-w-4xl text-center">
          <!-- Badge -->
          <div
            class="mb-8 inline-flex animate-fade-in items-center rounded-full border border-white/60 bg-white/40 px-4 py-2 shadow-2xl backdrop-blur-xl"
          >
            <svg
              class="mr-2 h-4 w-4 text-primary-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
              ></path>
            </svg>
            <span class="text-sm font-medium text-white drop-shadow-lg"
              >Estamos aquí para ayudarte</span
            >
          </div>

          <!-- Título principal -->
          <h1
            class="text-shadow-strong mb-6 animate-fade-in text-4xl font-bold text-white delay-200 sm:text-5xl md:text-7xl"
          >
            <span class="text-orange-400 drop-shadow-[0_2px_10px_rgba(251,146,60,0.5)]">
              Contacta
            </span>
            con nosotros
          </h1>

          <!-- Descripción -->
          <p
            class="text-shadow-soft mx-auto mb-6 max-w-3xl animate-fade-in text-lg leading-relaxed text-white/95 delay-300 sm:text-xl md:text-2xl"
          >
            ¿Tienes alguna consulta, sugerencia o quieres colaborar? Estaremos encantados de
            escucharte.
          </p>
        </div>
      </div>

      <!-- Wave decoration -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg
          class="h-16 w-full fill-white sm:h-20 md:h-32"
          viewBox="0 0 1440 120"
          preserveAspectRatio="none"
        >
          <path
            d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- Sección de Contacto -->
    <section class="relative overflow-hidden bg-white py-20 md:py-28">
      <!-- Decoración de fondo -->
      <div
        class="absolute left-0 top-1/4 h-96 w-96 -translate-x-1/2 rounded-full bg-gradient-to-br from-primary-100/60 to-accent-100/60 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-1/4 right-0 h-72 w-72 translate-x-1/2 rounded-full bg-gradient-to-br from-accent-100/60 to-primary-100/60 blur-3xl"
      >
      </div>

      <div class="section-container relative">
        <div class="mx-auto max-w-6xl">
          <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
            <!-- Información de contacto -->
            <div>
              <span
                class="mb-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-4 py-2 text-sm font-semibold text-primary-700"
              >
                Información
              </span>
              <h2 class="mb-6 text-3xl font-bold text-gray-900 md:text-4xl">
                ¿Cómo podemos
                <span
                  class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent"
                >
                  ayudarte?
                </span>
              </h2>
              <p class="mb-8 text-lg text-gray-600">
                Puedes contactarnos a través de cualquiera de estos medios. Responderemos lo antes
                posible.
              </p>

              <!-- Tarjetas de contacto -->
              <div class="space-y-4">
                <!-- Email -->
                <div
                  class="group flex items-start gap-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                >
                  <div
                    class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-primary-400 to-cyan-500 shadow-lg shadow-primary-500/30"
                  >
                    <svg
                      class="h-6 w-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900">Email</h3>
                    <a
                      href="mailto:info@divermataro.org"
                      class="text-primary-600 transition-colors hover:text-primary-700"
                    >
                      info@divermataro.org
                    </a>
                  </div>
                </div>

                <!-- Ubicación -->
                <div
                  class="group flex items-start gap-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                >
                  <div
                    class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent-400 to-pink-500 shadow-lg shadow-accent-500/30"
                  >
                    <svg
                      class="h-6 w-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                      ></path>
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900">Ubicación</h3>
                    <p class="text-gray-600">Mataró, Barcelona</p>
                  </div>
                </div>

                <!-- Redes sociales -->
                <div
                  class="group flex items-start gap-4 rounded-2xl border border-gray-100 bg-white p-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                >
                  <div
                    class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-orange-400 to-amber-500 shadow-lg shadow-orange-500/30"
                  >
                    <svg
                      class="h-6 w-6 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900">Redes Sociales</h3>
                    <div class="mt-2 flex gap-3">
                      <a
                        href="https://www.facebook.com/groups/divermataro"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary-600 transition-all hover:scale-110 hover:bg-primary-200"
                        aria-label="Facebook"
                      >
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                          <path
                            d="M18.77,7.46H14.5v-1.9c0-.9.6-1.1,1-1.1h3V.5h-4.33C10.24.5,9.5,3.44,9.5,5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4Z"
                          ></path>
                        </svg>
                      </a>
                      <a
                        href="https://www.instagram.com/divermataro"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex h-10 w-10 items-center justify-center rounded-full bg-accent-100 text-accent-600 transition-all hover:scale-110 hover:bg-accent-200"
                        aria-label="Instagram"
                      >
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                          <path
                            d="M12,2.16c3.2,0,3.58,0,4.85.07,3.25.15,4.77,1.69,4.92,4.92.06,1.27.07,1.65.07,4.85s0,3.58-.07,4.85c-.15,3.23-1.66,4.77-4.92,4.92-1.27.06-1.65.07-4.85.07s-3.58,0-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s0-3.58.07-4.85C2.38,3.92,3.9,2.38,7.15,2.23,8.42,2.18,8.8,2.16,12,2.16ZM12,0C8.74,0,8.33,0,7.05.07c-4.35.2-6.78,2.62-7,7C0,8.33,0,8.74,0,12s0,3.67.07,4.95c.2,4.36,2.62,6.78,7,7C8.33,24,8.74,24,12,24s3.67,0,4.95-.07c4.35-.2,6.78-2.62,7-7C24,15.67,24,15.26,24,12s0-3.67-.07-4.95c-.2-4.35-2.62-6.78-7-7C15.67,0,15.26,0,12,0Zm0,5.84A6.16,6.16,0,1,0,18.16,12,6.16,6.16,0,0,0,12,5.84ZM12,16a4,4,0,1,1,4-4A4,4,0,0,1,12,16ZM18.41,4.15a1.44,1.44,0,1,0,1.44,1.44A1.44,1.44,0,0,0,18.41,4.15Z"
                          ></path>
                        </svg>
                      </a>
                      <a
                        href="https://twitter.com/divermataro"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition-all hover:scale-110 hover:bg-gray-200"
                        aria-label="X (Twitter)"
                      >
                        <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                          <path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                          ></path>
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Formulario de contacto -->
            <div>
              <div class="rounded-3xl border border-gray-100 bg-white p-8 shadow-xl">
                <h3 class="mb-6 text-2xl font-bold text-gray-900">Envíanos un mensaje</h3>

                <!-- Mensaje de estado -->
                <div id="form-status" class="mb-6 hidden rounded-xl p-4 text-center"></div>

                <form id="contact-form" class="space-y-5">
                  <div>
                    <label for="nombre" class="mb-2 block text-sm font-medium text-gray-700">
                      Nombre completo
                    </label>
                    <input
                      type="text"
                      id="nombre"
                      name="nombre"
                      required
                      class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 transition-all focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                      placeholder="Tu nombre"
                    />
                  </div>

                  <div>
                    <label for="email" class="mb-2 block text-sm font-medium text-gray-700">
                      Email
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 transition-all focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                      placeholder="tu@email.com"
                    />
                  </div>

                  <div>
                    <label for="asunto" class="mb-2 block text-sm font-medium text-gray-700">
                      Asunto
                    </label>
                    <select
                      id="asunto"
                      name="asunto"
                      required
                      class="w-full rounded-xl border border-gray-200 px-4 py-3 text-gray-900 transition-all focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                    >
                      <option value="">Selecciona un asunto</option>
                      <option value="informacion">Información general</option>
                      <option value="asociarse">Quiero asociarme</option>
                      <option value="denuncia">Denunciar barrera de accesibilidad</option>
                      <option value="colaborar">Quiero colaborar</option>
                      <option value="otro">Otro</option>
                    </select>
                  </div>

                  <div>
                    <label for="mensaje" class="mb-2 block text-sm font-medium text-gray-700">
                      Mensaje
                    </label>
                    <textarea
                      id="mensaje"
                      name="mensaje"
                      rows="5"
                      required
                      class="w-full resize-none rounded-xl border border-gray-200 px-4 py-3 text-gray-900 transition-all focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20"
                      placeholder="¿En qué podemos ayudarte?"></textarea>
                  </div>

                  <button
                    type="submit"
                    class="group w-full rounded-xl bg-gradient-to-r from-primary-600 to-accent-600 px-6 py-4 font-bold text-white shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl"
                  >
                    <span class="flex items-center justify-center gap-2">
                      Enviar mensaje
                      <svg
                        class="h-5 w-5 transition-transform group-hover:translate-x-1"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                      </svg>
                    </span>
                  </button>
                </form>

                <p class="mt-4 text-center text-sm text-gray-500">
                  Responderemos a tu mensaje lo antes posible
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Sección CTA -->
    <section class="bg-gradient-to-r from-primary-600 to-accent-600 py-16 text-white md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-3xl text-center">
          <h2 class="mb-6 text-3xl font-bold md:text-4xl">¿Quieres unirte a nuestra causa?</h2>
          <p class="mb-8 text-xl text-primary-100">
            Juntos podemos conseguir una Mataró más accesible e inclusiva para todas las personas.
          </p>
          <a
            href="/asociate"
            class="btn bg-white px-8 py-4 text-lg text-primary-600 hover:bg-primary-50"
          >
            Asóciate Gratis
          </a>
          <p class="mt-4 text-sm text-primary-200">
            No cobramos ningún tipo de cuota • Todo es voluntario
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  const submitButtonText = submitButton?.querySelector('span');
  const originalButtonContent = submitButtonText?.innerHTML || '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Deshabilitar botón y mostrar estado de carga
    submitButton.disabled = true;
    if (submitButtonText) {
      submitButtonText.innerHTML = `
        <svg class="h-5 w-5 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Enviando...</span>
      `;
    }

    // Ocultar mensaje anterior
    statusDiv.classList.add('hidden');

    // Recoger datos del formulario
    const formData = new FormData(form);
    const data = {
      nombre: formData.get('nombre'),
      email: formData.get('email'),
      asunto: formData.get('asunto'),
      mensaje: formData.get('mensaje'),
    };

    try {
      const response = await fetch('/api/contacto', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        // Éxito
        statusDiv.className =
          'mb-6 rounded-xl p-4 text-center bg-green-50 text-green-700 border border-green-200';
        statusDiv.innerHTML = `
          <div class="flex items-center justify-center gap-2">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>¡Mensaje enviado correctamente! Te responderemos pronto.</span>
          </div>
        `;
        statusDiv.classList.remove('hidden');
        form.reset();
      } else {
        // Error del servidor
        throw new Error(result.error || 'Error al enviar el mensaje');
      }
    } catch (error) {
      // Error
      statusDiv.className =
        'mb-6 rounded-xl p-4 text-center bg-red-50 text-red-700 border border-red-200';
      statusDiv.innerHTML = `
        <div class="flex items-center justify-center gap-2">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
          <span>${error instanceof Error ? error.message : 'Error al enviar el mensaje. Inténtalo de nuevo.'}</span>
        </div>
      `;
      statusDiv.classList.remove('hidden');
    } finally {
      // Restaurar botón
      submitButton.disabled = false;
      if (submitButtonText) {
        submitButtonText.innerHTML = originalButtonContent;
      }
    }
  });
</script>
