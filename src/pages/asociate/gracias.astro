---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import HeroBackground from '../../components/HeroBackground.astro';
import { getRandomHeroImage } from '../../lib/heroImages';

const heroImage = getRandomHeroImage();
---

<BaseLayout
  title="¡Gracias por unirte! - Diversidad Funcional Mataró"
  description="Gracias por unirte a nuestra asociación"
>
  <Header />
  <main id="main-content">
    <!-- Hero Section -->
    <section
      class="relative flex min-h-[70vh] items-center justify-center overflow-hidden pt-16 md:min-h-[80vh] md:pt-20"
    >
      <!-- Fondo con imagen responsive -->
      <HeroBackground
        image={heroImage}
        gradientClass="from-green-600/85 via-primary-700/75 to-accent-600/85"
      />

      <!-- Iconos flotantes decorativos -->
      <div class="absolute left-10 top-32 z-10 hidden animate-float lg:block">
        <div
          class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg class="h-8 w-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>

      <div class="absolute right-16 top-40 z-10 hidden animate-float-delay lg:block">
        <div
          class="flex h-20 w-20 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg
            class="h-10 w-10 text-orange-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            ></path>
          </svg>
        </div>
      </div>

      <!-- Contenido principal -->
      <div class="section-container relative z-20 py-20">
        <div class="mx-auto max-w-4xl text-center">
          <!-- Icono de éxito -->
          <div class="mb-8 inline-flex animate-fade-in items-center justify-center">
            <div
              class="flex h-24 w-24 items-center justify-center rounded-full border-4 border-white/60 bg-white/40 shadow-2xl backdrop-blur-xl"
            >
              <svg
                class="h-12 w-12 text-green-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
          </div>

          <!-- Título principal -->
          <h1
            class="text-shadow-strong mb-6 animate-fade-in text-4xl font-bold text-white delay-200 sm:text-5xl md:text-7xl"
          >
            <span class="text-green-400 drop-shadow-[0_2px_10px_rgba(74,222,128,0.5)]">
              ¡Gracias
            </span>
            por unirte!
          </h1>

          <!-- Descripción -->
          <p
            class="text-shadow-soft mx-auto mb-10 max-w-3xl animate-fade-in text-lg leading-relaxed text-white/95 delay-300 sm:text-xl md:text-2xl"
          >
            Tu solicitud ha sido recibida correctamente. Nos pondremos en contacto contigo muy
            pronto a través de WhatsApp.
          </p>

          <!-- CTA principal: WhatsApp -->
          <div class="delay-400 mb-6 animate-fade-in">
            <a
              href="https://chat.whatsapp.com/DRlG1gYTC596ta62wY3uas"
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex transform items-center justify-center rounded-2xl bg-[#25D366] px-10 py-5 text-lg font-bold text-white shadow-2xl transition-all duration-300 hover:scale-105 hover:bg-[#20bd5a]"
            >
              <svg class="mr-3 h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
              <span>Unirte a nuestro grupo de WhatsApp</span>
            </a>
          </div>

          <!-- CTAs secundarios -->
          <div
            class="flex animate-fade-in flex-col items-center justify-center gap-4 delay-500 sm:flex-row"
          >
            <a
              href="/"
              class="group inline-flex transform items-center justify-center rounded-2xl bg-white px-8 py-4 font-bold text-primary-600 shadow-2xl transition-all duration-300 hover:scale-105 hover:bg-primary-50"
            >
              <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                ></path>
              </svg>
              <span>Volver al inicio</span>
            </a>
            <a
              href="/blog"
              class="group inline-flex transform items-center justify-center rounded-2xl border-2 border-white bg-white/10 px-8 py-4 font-bold text-white shadow-2xl backdrop-blur-sm transition-all duration-300 hover:scale-105 hover:bg-white/20"
            >
              <span>Leer nuestro blog</span>
              <svg
                class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Wave decoration -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg
          class="h-16 w-full fill-white sm:h-20 md:h-32"
          viewBox="0 0 1440 120"
          preserveAspectRatio="none"
        >
          <path
            d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- Sección de próximos pasos -->
    <section class="bg-white py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-3xl text-center">
          <span
            class="mb-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-4 py-2 text-sm font-semibold text-primary-700"
          >
            Próximos pasos
          </span>
          <h2 class="mb-8 text-3xl font-bold text-gray-900 md:text-4xl">
            ¿Qué pasará
            <span
              class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent"
            >
              ahora?
            </span>
          </h2>

          <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-lg">
              <div
                class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-primary-400 to-cyan-500 text-xl font-bold text-white"
              >
                1
              </div>
              <h3 class="mb-2 font-bold text-gray-900">Revisamos tu solicitud</h3>
              <p class="text-sm text-gray-600">Verificamos los datos que nos has proporcionado.</p>
            </div>

            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-lg">
              <div
                class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-accent-400 to-pink-500 text-xl font-bold text-white"
              >
                2
              </div>
              <h3 class="mb-2 font-bold text-gray-900">Te contactamos</h3>
              <p class="text-sm text-gray-600">
                Te escribiremos por WhatsApp para darte la bienvenida.
              </p>
            </div>

            <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-lg">
              <div
                class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-green-400 to-emerald-500 text-xl font-bold text-white"
              >
                3
              </div>
              <h3 class="mb-2 font-bold text-gray-900">¡Únete al grupo!</h3>
              <p class="mb-3 text-sm text-gray-600">
                Entra en nuestro grupo de WhatsApp para estar al día de todo.
              </p>
              <a
                href="https://chat.whatsapp.com/DRlG1gYTC596ta62wY3uas"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center rounded-lg bg-[#25D366] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#20bd5a]"
              >
                <svg class="mr-1.5 h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
                Unirse al grupo
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
