---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import { getSocialImageMeta } from '../../lib/getSocialImage';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts.map((post: CollectionEntry<'blog'>) => {
    // En Astro 6, el slug puede venir de diferentes formas
    const slug = post.id || post.slug || 'unknown';
    return {
      params: { slug },
      props: { post },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const currentId = post.id || post.slug || 'unknown';

// URL canónica para compartir (coincide con la barra final que usa el servidor)
const canonicalUrl = new URL(`/blog/${currentId}/`, Astro.site || 'https://divermataro.org').href;

// Imagen para redes sociales: AVIF no es compatible con la mayoría de crawlers OG
const socialImageMeta = getSocialImageMeta(post.data.heroImage);

// Obtener posts relacionados
const allPosts = await getCollection('blog');

const relatedPosts = allPosts
  .filter((p: CollectionEntry<'blog'>) => (p.id || p.slug) !== currentId)
  .sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => {
    // Priorizar misma categoría
    if (
      post.data.category &&
      a.data.category === post.data.category &&
      b.data.category !== post.data.category
    ) {
      return -1;
    }
    if (
      post.data.category &&
      a.data.category !== post.data.category &&
      b.data.category === post.data.category
    ) {
      return 1;
    }
    // Luego por fecha
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={`${post.data.title} - Blog Asociación Diversidad Funcional`}
  description={post.data.description}
  ogImage={socialImageMeta.src}
  ogImageAlt={post.data.title}
  ogImageType={socialImageMeta.type}
  ogImageWidth={socialImageMeta.width}
  ogImageHeight={socialImageMeta.height}
  canonicalUrl={canonicalUrl}
>
  <Header />
  <main class="min-h-screen bg-white">
    <article class="py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-4xl">
          <a
            href="/blog"
            class="mb-8 inline-flex items-center gap-2 text-primary-600 hover:text-primary-700"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Volver al blog
          </a>

          <header class="mb-8">
            <div class="mb-4 text-sm text-gray-500">
              {
                post.data.pubDate.toLocaleDateString('es-ES', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
              {
                post.data.updatedDate && (
                  <span class="ml-2">
                    (Actualizado:{' '}
                    {post.data.updatedDate.toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                    )
                  </span>
                )
              }
            </div>
            <h1 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl">
              {post.data.title}
            </h1>
            {
              post.data.description && (
                <p class="mb-4 text-xl text-gray-600">{post.data.description}</p>
              )
            }
            {
              post.data.category && (
                <a
                  href={`/blog/categoria/${post.data.category.toLowerCase()}`}
                  class="inline-block rounded-full bg-primary-100 px-4 py-2 text-sm font-semibold text-primary-700 transition-all hover:bg-primary-200 hover:shadow-md"
                >
                  {post.data.category}
                </a>
              )
            }
          </header>

          {
            post.data.heroImage && (
              <img
                src={post.data.heroImage}
                alt={post.data.title}
                class="mb-8 h-64 w-full rounded-xl object-cover md:h-96"
                transition:name={`hero-${post.id || post.slug}`}
              />
            )
          }

          <div
            class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-primary-600 hover:prose-a:text-primary-700 prose-img:rounded-xl"
          >
            <Content />
          </div>

          <div
            class="mt-12 overflow-hidden rounded-2xl border border-gray-100 bg-gradient-to-br from-gray-50 to-primary-50/30 p-6"
          >
            <div class="mb-1 flex items-center gap-2">
              <svg
                class="h-5 w-5 text-primary-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                ></path>
              </svg>
              <p class="text-base font-bold text-gray-900">Comparte este artículo</p>
            </div>
            <p class="mb-5 text-sm text-gray-500">Ayuda a difundir esta información</p>
            <div class="grid grid-cols-4 gap-2.5">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-md"
                aria-label="Compartir en X"
              >
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-transform duration-200 group-hover:scale-110"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                    ></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">X</span>
              </a>
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#1877F2]/40 hover:shadow-md"
                aria-label="Compartir en Facebook"
              >
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1877F2] text-white transition-transform duration-200 group-hover:scale-110"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                    ></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">Facebook</span>
              </a>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#25D366]/40 hover:shadow-md"
                aria-label="Compartir por WhatsApp"
              >
                <span
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform duration-200 group-hover:scale-110"
                >
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                    ></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">WhatsApp</span>
              </a>
              <button
                type="button"
                id="copy-link-btn"
                data-url={canonicalUrl}
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-400 hover:shadow-md"
                aria-label="Copiar enlace"
              >
                <span
                  id="copy-icon-wrapper"
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-primary-500 to-accent-500 text-white transition-transform duration-200 group-hover:scale-110"
                >
                  <svg
                    id="copy-icon"
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                    ></path>
                  </svg>
                  <svg
                    id="check-icon"
                    class="hidden h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span id="copy-link-text" class="text-xs font-semibold text-gray-700">Copiar</span>
              </button>
            </div>
          </div>

          <script>
            const copyBtn = document.getElementById('copy-link-btn');
            const copyText = document.getElementById('copy-link-text');
            const copyIcon = document.getElementById('copy-icon');
            const checkIcon = document.getElementById('check-icon');
            const iconWrapper = document.getElementById('copy-icon-wrapper');
            if (copyBtn && copyText && copyIcon && checkIcon && iconWrapper) {
              copyBtn.addEventListener('click', () => {
                const url = copyBtn.getAttribute('data-url') || window.location.href;
                // Método sin permisos: textarea oculto + execCommand
                const ta = document.createElement('textarea');
                ta.value = url;
                ta.setAttribute('readonly', '');
                ta.style.position = 'absolute';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                // Feedback visual
                copyIcon.classList.add('hidden');
                checkIcon.classList.remove('hidden');
                iconWrapper.classList.remove('from-primary-500', 'to-accent-500');
                iconWrapper.classList.add('from-green-500', 'to-green-600');
                copyText.textContent = 'Copiado';
                setTimeout(() => {
                  copyIcon.classList.remove('hidden');
                  checkIcon.classList.add('hidden');
                  iconWrapper.classList.remove('from-green-500', 'to-green-600');
                  iconWrapper.classList.add('from-primary-500', 'to-accent-500');
                  copyText.textContent = 'Copiar';
                }, 2000);
              });
            }
          </script>

          {/* Artículos relacionados */}
          {
            relatedPosts.length > 0 && (
              <div class="mt-16 border-t border-gray-200 pt-12">
                <h2 class="mb-8 text-2xl font-bold text-gray-900">También te puede interesar</h2>
                <div class="grid gap-8 md:grid-cols-3">
                  {relatedPosts.map((relatedPost: CollectionEntry<'blog'>) => (
                    <a href={`/blog/${relatedPost.id || relatedPost.slug}`} class="group block">
                      <div class="mb-4 aspect-video overflow-hidden rounded-xl bg-gray-100">
                        {relatedPost.data.heroImage ? (
                          <img
                            src={relatedPost.data.heroImage}
                            alt={relatedPost.data.title}
                            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                          />
                        ) : (
                          <div class="flex h-full w-full items-center justify-center text-gray-400">
                            <span class="text-4xl">📄</span>
                          </div>
                        )}
                      </div>
                      <h3 class="line-clamp-2 text-lg font-semibold text-gray-900 transition-colors group-hover:text-primary-600">
                        {relatedPost.data.title}
                      </h3>
                      <p class="mt-2 line-clamp-2 text-sm text-gray-500">
                        {relatedPost.data.description}
                      </p>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
