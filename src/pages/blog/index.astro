---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog', ({ data }: { data: { pubDate: Date } }) => {
  return data.pubDate <= new Date();
});

// Ordenar por fecha más reciente
const sortedPosts = [...blogPosts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
  title="Blog - Asociación Diversidad Funcional Mataró"
  description="Últimas noticias, logros y reivindicaciones de nuestra asociación"
>
  <Header />
  <main class="min-h-screen bg-gray-50">
    <section class="py-16 md:py-24">
      <div class="section-container">
        <h1 class="mb-4 text-center text-4xl font-bold text-gray-900 md:text-5xl">Nuestro Blog</h1>
        <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-gray-600">
          Conoce nuestros logros, reivindicaciones y el trabajo que realizamos día a día
        </p>

        {
          sortedPosts.length === 0 ? (
            <div class="py-12 text-center">
              <p class="text-lg text-gray-600">Próximamente publicaremos contenido aquí.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {sortedPosts.map((post) => {
                const slug = post.id || post.slug;
                return (
                  <a
                    href={`/blog/${slug}`}
                    class="card transition-transform duration-200 hover:scale-105"
                  >
                    {post.data.heroImage && (
                      <img
                        src={post.data.heroImage}
                        alt={post.data.title}
                        class="mb-4 h-48 w-full rounded-lg object-cover"
                        loading="lazy"
                      />
                    )}
                    <div class="mb-2 text-sm text-gray-500">
                      {post.data.pubDate.toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                      })}
                    </div>
                    <h2 class="mb-2 text-xl font-semibold text-gray-900">{post.data.title}</h2>
                    <p class="line-clamp-3 text-gray-600">{post.data.description}</p>
                    {post.data.category && (
                      <span class="mt-4 inline-block rounded-full bg-primary-100 px-3 py-1 text-sm text-primary-700">
                        {post.data.category}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
