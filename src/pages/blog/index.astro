---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog', ({ data }: { data: { pubDate: Date } }) => {
  return data.pubDate <= new Date();
});

// Ordenar por fecha más reciente
const sortedPosts = [...blogPosts].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<BaseLayout
  title="Blog - Asociación Diversidad Funcional Mataró"
  description="Últimas noticias, logros y reivindicaciones de nuestra asociación"
>
  <Header />
  <main id="main-content">
    <!-- Hero Section -->
    <section
      class="relative flex min-h-[70vh] items-center justify-center overflow-hidden pt-16 md:min-h-[80vh] md:pt-20"
    >
      <!-- Fondo con imagen -->
      <div class="absolute inset-0">
        <div
          class="absolute inset-0 bg-cover bg-no-repeat"
          style="background-image: url('https://res.cloudinary.com/dzs4olh43/image/upload/v1769508835/diverfaceww-minn-min_wvvllt.jpg'); background-position: center 30%;"
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-br from-primary-600/85 via-primary-700/75 to-accent-600/85"
        >
        </div>
      </div>

      <!-- Iconos flotantes decorativos -->
      <div class="absolute left-10 top-32 z-10 hidden animate-float lg:block">
        <div
          class="flex h-16 w-16 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg class="h-8 w-8 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
            ></path>
          </svg>
        </div>
      </div>

      <div class="absolute right-16 top-40 z-10 hidden animate-float-delay lg:block">
        <div
          class="flex h-20 w-20 items-center justify-center rounded-2xl border border-white/30 bg-white/20 shadow-2xl backdrop-blur-lg"
        >
          <svg
            class="h-10 w-10 text-orange-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
            ></path>
          </svg>
        </div>
      </div>

      <!-- Contenido principal -->
      <div class="section-container relative z-20 py-20">
        <div class="mx-auto max-w-4xl text-center">
          <!-- Badge -->
          <div
            class="mb-8 inline-flex animate-fade-in items-center rounded-full border border-white/60 bg-white/40 px-4 py-2 shadow-2xl backdrop-blur-xl"
          >
            <svg
              class="mr-2 h-4 w-4 text-primary-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              ></path>
            </svg>
            <span class="text-sm font-medium text-white drop-shadow-lg">Noticias y logros</span>
          </div>

          <!-- Título principal -->
          <h1
            class="text-shadow-strong mb-6 animate-fade-in text-4xl font-bold text-white delay-200 sm:text-5xl md:text-7xl"
          >
            Nuestro
            <span class="text-orange-400 drop-shadow-[0_2px_10px_rgba(251,146,60,0.5)]">
              Blog
            </span>
          </h1>

          <!-- Descripción -->
          <p
            class="text-shadow-soft mx-auto mb-6 max-w-3xl animate-fade-in text-lg leading-relaxed text-white/95 delay-300 sm:text-xl md:text-2xl"
          >
            Conoce nuestros logros, reivindicaciones y el trabajo que realizamos día a día por una
            Mataró más accesible.
          </p>

          <!-- CTA -->
          <div class="delay-400 flex animate-fade-in justify-center">
            <a
              href="#articulos"
              class="group inline-flex transform items-center justify-center rounded-2xl bg-white px-8 py-4 font-bold text-primary-600 shadow-2xl transition-all duration-300 hover:scale-105 hover:bg-primary-50"
            >
              <span>Ver artículos</span>
              <svg
                class="ml-3 h-5 w-5 transition-transform group-hover:translate-y-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Wave decoration -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg
          class="h-16 w-full fill-gray-50 sm:h-20 md:h-32"
          viewBox="0 0 1440 120"
          preserveAspectRatio="none"
        >
          <path
            d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,120L1392,120C1344,120,1248,120,1152,120C1056,120,960,120,864,120C768,120,672,120,576,120C480,120,384,120,288,120C192,120,96,120,48,120L0,120Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- Sección Artículos -->
    <section id="articulos" class="bg-gray-50 py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto mb-12 max-w-3xl text-center">
          <span
            class="mb-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-4 py-2 text-sm font-semibold text-primary-700"
          >
            Publicaciones
          </span>
          <h2 class="mb-4 text-3xl font-bold text-gray-900 md:text-4xl">
            Últimos
            <span
              class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent"
            >
              artículos
            </span>
          </h2>
          <p class="text-lg text-gray-600">
            Mantente informado sobre nuestras actividades y logros.
          </p>
        </div>

        {
          sortedPosts.length === 0 ? (
            <div class="py-12 text-center">
              <p class="text-lg text-gray-600">Próximamente publicaremos contenido aquí.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {sortedPosts.map((post) => {
                const slug = post.id || post.slug;
                return (
                  <a
                    href={`/blog/${slug}`}
                    class="group overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
                  >
                    {post.data.heroImage && (
                      <div class="relative overflow-hidden">
                        <img
                          src={post.data.heroImage}
                          alt={post.data.title}
                          class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                      </div>
                    )}
                    <div class="p-6">
                      <div class="mb-3 text-sm text-gray-500">
                        {post.data.pubDate.toLocaleDateString('es-ES', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                        })}
                      </div>
                      <h2 class="mb-2 text-xl font-bold text-gray-900 transition-colors group-hover:text-primary-600">
                        {post.data.title}
                      </h2>
                      <p class="line-clamp-3 text-gray-600">{post.data.description}</p>
                      {post.data.category && (
                        <span class="mt-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-3 py-1 text-sm font-semibold text-primary-700">
                          {post.data.category}
                        </span>
                      )}
                    </div>
                  </a>
                );
              })}
            </div>
          )
        }

        <div class="mt-12 text-center">
          <p class="text-sm text-gray-500">
            ¿Tienes una historia que contar? <a
              href="/contacto"
              class="text-primary-600 hover:underline">Contáctanos</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
