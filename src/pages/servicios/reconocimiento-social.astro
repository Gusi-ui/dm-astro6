---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import { getRandomHeroImage } from '../../lib/heroImages';

const heroImage = getRandomHeroImage();
---

<BaseLayout title="Reconocimiento Social - DiverMataró">
  <Header />
  <main id="main-content">
    <!-- Hero de la página -->
    <section
      class="relative flex min-h-[70vh] items-center justify-center overflow-hidden pt-16 md:min-h-[80vh] md:pt-20"
    >
      <!-- Fondo con imagen -->
      <div class="absolute inset-0">
        <div
          class="absolute inset-0 bg-cover bg-no-repeat"
          style={`background-image: url('${heroImage}'); background-position: center 30%;`}
        >
        </div>
        <div
          class="absolute inset-0 bg-gradient-to-br from-primary-600/85 via-primary-700/75 to-accent-600/85"
        >
        </div>
      </div>
      <div class="section-container relative z-10">
        <div class="mx-auto max-w-4xl text-center">
          <div
            class="mb-6 inline-flex items-center rounded-full border border-white/30 bg-white/20 px-4 py-2 backdrop-blur-xl"
          >
            <div
              class="mr-3 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-yellow-400 to-orange-500"
            >
              <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"
                ></path>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">Nuestros Servicios</span>
          </div>
          <h1 class="text-shadow-strong mb-6 text-4xl font-bold text-white md:text-6xl">
            Reconocimiento Social
          </h1>
          <p class="text-shadow-soft text-xl text-white/90 md:text-2xl">
            Cambiando la percepción social de la diversidad funcional
          </p>
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0">
        <svg
          class="h-16 w-full fill-white md:h-24"
          viewBox="0 0 1440 120"
          preserveAspectRatio="none"
        >
          <path
            d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,120L0,120Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- Contenido principal -->
    <section class="py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-4xl">
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl font-bold text-gray-900">
              Transformando miradas, construyendo respeto
            </h2>
            <p class="text-lg leading-relaxed text-gray-700">
              El reconocimiento social es fundamental para lograr una verdadera inclusión.
              Trabajamos para cambiar la percepción que la sociedad tiene de las personas con
              diversidad funcional, promoviendo una imagen positiva, realista y alejada de
              estereotipos.
            </p>

            <h3 class="mt-10 text-2xl font-bold text-gray-900">Líneas de actuación</h3>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-yellow-400 to-orange-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Visibilización positiva</h4>
                <p class="text-gray-600">
                  Mostramos las capacidades, talentos y aportaciones de las personas con diversidad
                  funcional.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-400 to-cyan-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Educación y sensibilización</h4>
                <p class="text-gray-600">
                  Charlas en centros educativos y empresas para fomentar el respeto y la
                  comprensión.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-accent-400 to-pink-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Presencia en medios</h4>
                <p class="text-gray-600">
                  Promovemos una representación digna y realista en medios de comunicación y
                  cultura.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-green-400 to-emerald-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Diálogo social</h4>
                <p class="text-gray-600">
                  Fomentamos el diálogo entre personas con y sin diversidad funcional para derribar
                  prejuicios.
                </p>
              </div>
            </div>

            <h3 class="mt-10 text-2xl font-bold text-gray-900">Lo que queremos conseguir</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Eliminar los estereotipos negativos asociados a la diversidad funcional</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span
                  >Que se valore a las personas por sus capacidades, no por sus limitaciones</span
                >
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span
                  >Normalizar la presencia de personas con diversidad funcional en todos los ámbitos</span
                >
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Crear una sociedad más empática y comprensiva</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Que la diversidad sea vista como riqueza, no como problema</span>
              </li>
            </ul>
          </div>

          <!-- CTA -->
          <div
            class="mt-16 rounded-3xl bg-gradient-to-r from-primary-600 to-accent-600 p-8 text-center md:p-12"
          >
            <h3 class="mb-4 text-2xl font-bold text-white md:text-3xl">
              ¿Quieres ayudar a cambiar la percepción social?
            </h3>
            <p class="mb-8 text-lg text-white/90">
              Cada persona que se suma es una voz más para construir una sociedad más justa.
            </p>
            <a
              href="/asociate"
              class="inline-flex items-center rounded-2xl bg-white px-8 py-4 font-bold text-primary-600 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-primary-50"
            >
              <span>Suma tu voz</span>
              <svg class="ml-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>

          <!-- Volver -->
          <div class="mt-12 text-center">
            <a
              href="/#servicios"
              class="inline-flex items-center font-semibold text-primary-600 hover:text-primary-700"
            >
              <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              Volver a servicios
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
