---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/sections/Header.astro';
import Footer from '../../components/sections/Footer.astro';
---

<BaseLayout title="Apoyo Personalizado - DiverMataró">
  <Header />
  <main id="main-content">
    <!-- Hero de la página -->
    <section
      class="relative overflow-hidden bg-gradient-to-br from-primary-600 via-primary-700 to-accent-600 py-20 md:py-28"
    >
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="section-container relative z-10">
        <div class="mx-auto max-w-4xl text-center">
          <div
            class="mb-6 inline-flex items-center rounded-full border border-white/30 bg-white/20 px-4 py-2 backdrop-blur-xl"
          >
            <div
              class="mr-3 flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-orange-400 to-amber-500"
            >
              <svg
                class="h-5 w-5 text-white"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <line x1="19" x2="19" y1="8" y2="14"></line>
                <line x1="22" x2="16" y1="11" y2="11"></line>
              </svg>
            </div>
            <span class="text-sm font-medium text-white">Nuestros Servicios</span>
          </div>
          <h1 class="text-shadow-strong mb-6 text-4xl font-bold text-white md:text-6xl">
            Apoyo Personalizado
          </h1>
          <p class="text-shadow-soft text-xl text-white/90 md:text-2xl">
            Acompañamiento individualizado adaptado a tus necesidades
          </p>
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0">
        <svg
          class="h-16 w-full fill-white md:h-24"
          viewBox="0 0 1440 120"
          preserveAspectRatio="none"
        >
          <path
            d="M0,64L48,69.3C96,75,192,85,288,80C384,75,480,53,576,48C672,43,768,53,864,58.7C960,64,1056,64,1152,58.7C1248,53,1344,43,1392,37.3L1440,32L1440,120L0,120Z"
          ></path>
        </svg>
      </div>
    </section>

    <!-- Contenido principal -->
    <section class="py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-4xl">
          <div class="prose prose-lg max-w-none">
            <h2 class="text-3xl font-bold text-gray-900">¿Qué es el Apoyo Personalizado?</h2>
            <p class="text-lg leading-relaxed text-gray-700">
              En DiverMataró entendemos que cada persona es única, con sus propias necesidades,
              aspiraciones y circunstancias. Por eso, nuestro servicio de Apoyo Personalizado se
              centra en ofrecer un acompañamiento individualizado que se adapta completamente a cada
              situación.
            </p>

            <h3 class="mt-10 text-2xl font-bold text-gray-900">¿Cómo te ayudamos?</h3>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-orange-400 to-amber-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Evaluación inicial</h4>
                <p class="text-gray-600">
                  Analizamos tu situación específica para diseñar un plan de apoyo a medida.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-primary-400 to-cyan-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Acompañamiento continuo</h4>
                <p class="text-gray-600">
                  Te acompañamos en todo el proceso, ajustando el apoyo según evolucionen tus
                  necesidades.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-accent-400 to-pink-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
                    ></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Escucha activa</h4>
                <p class="text-gray-600">
                  Tus opiniones y preferencias son fundamentales en cada decisión que tomamos
                  juntos.
                </p>
              </div>
              <div class="rounded-2xl border-2 border-gray-100 bg-white p-6 shadow-lg">
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-green-400 to-emerald-500"
                >
                  <svg
                    class="h-6 w-6 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <h4 class="text-lg font-bold text-gray-900">Empoderamiento</h4>
                <p class="text-gray-600">
                  Nuestro objetivo es que ganes autonomía e independencia en tu día a día.
                </p>
              </div>
            </div>

            <h3 class="mt-10 text-2xl font-bold text-gray-900">Áreas de apoyo</h3>
            <ul class="mt-4 space-y-3">
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span
                  >Orientación en trámites administrativos y gestiones con la administración pública</span
                >
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Acompañamiento en procesos de búsqueda de empleo y formación</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Apoyo emocional y social para afrontar situaciones difíciles</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Asesoramiento sobre recursos y ayudas disponibles</span>
              </li>
              <li class="flex items-start">
                <span class="mr-3 text-primary-600">✓</span>
                <span>Mediación con instituciones y servicios públicos</span>
              </li>
            </ul>
          </div>

          <!-- CTA -->
          <div
            class="mt-16 rounded-3xl bg-gradient-to-r from-primary-600 to-accent-600 p-8 text-center md:p-12"
          >
            <h3 class="mb-4 text-2xl font-bold text-white md:text-3xl">
              ¿Necesitas apoyo personalizado?
            </h3>
            <p class="mb-8 text-lg text-white/90">
              Estamos aquí para ayudarte. Contáctanos y empezaremos a trabajar juntos.
            </p>
            <a
              href="/asociate"
              class="inline-flex items-center rounded-2xl bg-white px-8 py-4 font-bold text-primary-600 shadow-lg transition-all duration-300 hover:scale-105 hover:bg-primary-50"
            >
              <span>Contactar ahora</span>
              <svg class="ml-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>

          <!-- Volver -->
          <div class="mt-12 text-center">
            <a
              href="/#servicios"
              class="inline-flex items-center font-semibold text-primary-600 hover:text-primary-700"
            >
              <svg class="mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 19l-7-7 7-7"></path>
              </svg>
              Volver a servicios
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
