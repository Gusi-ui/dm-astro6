---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';

// En un caso real, esto podría venir de una base de datos o archivo de configuración
const documentos = [
  {
    id: 1,
    title: 'Estatutos de la Asociación',
    description: 'Documento oficial con los estatutos y normas de nuestra asociación',
    category: 'Legal',
    file: '/documents/estatutos.pdf',
    size: '245 KB',
    date: '2024-01-15',
  },
  {
    id: 2,
    title: 'Memoria de Actividades 2023',
    description: 'Resumen de todas las actividades y logros conseguidos durante el año 2023',
    category: 'Informes',
    file: '/documents/memoria-2023.pdf',
    size: '1.2 MB',
    date: '2024-01-10',
  },
  {
    id: 3,
    title: 'Guía de Accesibilidad',
    description: 'Guía práctica sobre accesibilidad universal para espacios públicos',
    category: 'Guías',
    file: '/documents/guia-accesibilidad.pdf',
    size: '856 KB',
    date: '2024-01-05',
  },
];

// const categorias = ['Todas', ...new Set(documentos.map(doc => doc.category))]; // Reservado para futuras funcionalidades
---

<BaseLayout
  title="Documentos - Asociación Diversidad Funcional Mataró"
  description="Documentos, informes y guías descargables de nuestra asociación"
>
  <Header />
  <main class="min-h-screen bg-gray-50">
    <section class="py-16 md:py-24">
      <div class="section-container">
        <h1 class="mb-4 text-center text-4xl font-bold text-gray-900 md:text-5xl">Documentos</h1>
        <p class="mx-auto mb-12 max-w-2xl text-center text-lg text-gray-600">
          Descarga documentos, informes y guías sobre nuestras actividades y reivindicaciones
        </p>

        {
          documentos.length === 0 ? (
            <div class="py-12 text-center">
              <p class="text-lg text-gray-600">Próximamente añadiremos documentos aquí.</p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
              {documentos.map((doc) => (
                <div class="card">
                  <div class="mb-4 flex items-start justify-between">
                    <div class="flex-1">
                      <h3 class="mb-2 text-xl font-semibold text-gray-900">{doc.title}</h3>
                      <p class="mb-3 text-sm text-gray-600">{doc.description}</p>
                    </div>
                    <svg
                      class="ml-4 h-8 w-8 flex-shrink-0 text-primary-600"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"
                      />
                    </svg>
                  </div>

                  <div class="mb-4 flex items-center justify-between text-sm text-gray-500">
                    <span class="rounded-full bg-primary-100 px-3 py-1 text-primary-700">
                      {doc.category}
                    </span>
                    <span>{doc.size}</span>
                  </div>

                  <div class="mb-4 text-xs text-gray-500">
                    Publicado:{' '}
                    {new Date(doc.date).toLocaleDateString('es-ES', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </div>

                  <a href={doc.file} download class="btn-primary w-full text-center">
                    Descargar PDF
                  </a>
                </div>
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
