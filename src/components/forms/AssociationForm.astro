---

---

<form method="POST" action="/api/associate" class="space-y-6">
  <div>
    <label for="name" class="mb-2 block text-sm font-semibold text-gray-700">
      Nombre completo <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder="Tu nombre completo"
      aria-required="true"
    />
  </div>

  <div>
    <label for="email" class="mb-2 block text-sm font-semibold text-gray-700">
      Email <span class="text-red-500">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder="tu@email.com"
      aria-required="true"
    />
  </div>

  <div>
    <label for="phone" class="mb-2 block text-sm font-semibold text-gray-700">
      Teléfono (opcional)
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder="+34 600 000 000"
    />
    <p class="mt-1 text-sm text-gray-500">Usaremos WhatsApp para comunicarnos contigo</p>
  </div>

  <div>
    <label for="message" class="mb-2 block text-sm font-semibold text-gray-700">
      Mensaje (opcional)
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      maxlength="500"
      class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder="Cuéntanos por qué quieres unirte o si tienes alguna pregunta..."></textarea>
    <p class="mt-1 text-sm text-gray-500">Máximo 500 caracteres</p>
  </div>

  <div id="form-message" class="hidden rounded-lg p-4"></div>

  <button type="submit" class="btn-primary w-full py-4 text-lg" id="submit-button">
    Enviar Solicitud
  </button>

  <p class="text-center text-sm text-gray-600">
    Al enviar este formulario, aceptas que nos pongamos en contacto contigo vía WhatsApp.
  </p>
</form>

<script>
  const form = document.querySelector('form');
  const formMessage = document.getElementById('form-message');
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;

  if (form && formMessage && submitButton) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';
      formMessage.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        formMessage.classList.remove('hidden');

        if (result.success) {
          // Redirigir a la página de gracias
          window.location.href = '/asociate/gracias';
          return;
        } else {
          formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
          formMessage.textContent = result.error || 'Error al enviar el formulario';
        }
      } catch (error) {
        formMessage.classList.remove('hidden');
        formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
        formMessage.textContent = 'Error de conexión. Por favor, intenta de nuevo.';
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Enviar Solicitud';
        }
      }
    });
  }
</script>
