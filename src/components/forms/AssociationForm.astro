---
---

<form method="POST" action="/api/associate" class="space-y-6">
  <div>
    <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
      Nombre completo <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
      placeholder="Tu nombre completo"
      aria-required="true"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">
      Email <span class="text-red-500">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
      placeholder="tu@email.com"
      aria-required="true"
    />
  </div>

  <div>
    <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">
      Teléfono (opcional)
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors"
      placeholder="+34 600 000 000"
    />
    <p class="mt-1 text-sm text-gray-500">Usaremos WhatsApp para comunicarnos contigo</p>
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">
      Mensaje (opcional)
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      maxlength="500"
      class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors resize-none"
      placeholder="Cuéntanos por qué quieres unirte o si tienes alguna pregunta..."
    ></textarea>
    <p class="mt-1 text-sm text-gray-500">Máximo 500 caracteres</p>
  </div>

  <div id="form-message" class="hidden p-4 rounded-lg"></div>

  <button
    type="submit"
    class="w-full btn-primary text-lg py-4"
    id="submit-button"
  >
    Enviar Solicitud
  </button>

  <p class="text-sm text-gray-600 text-center">
    Al enviar este formulario, aceptas que nos pongamos en contacto contigo vía WhatsApp.
  </p>
</form>

<script>
  const form = document.querySelector('form');
  const formMessage = document.getElementById('form-message');
  const submitButton = document.getElementById('submit-button');

  if (form && formMessage && submitButton) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      submitButton.disabled = true;
      submitButton.textContent = 'Enviando...';
      formMessage.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        formMessage.classList.remove('hidden');
        
        if (result.success) {
          formMessage.className = 'p-4 rounded-lg bg-green-50 text-green-800 border border-green-200';
          formMessage.textContent = result.message || '¡Gracias por unirte!';
          form.reset();
        } else {
          formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
          formMessage.textContent = result.error || 'Error al enviar el formulario';
        }
      } catch (error) {
        formMessage.classList.remove('hidden');
        formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
        formMessage.textContent = 'Error de conexión. Por favor, intenta de nuevo.';
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Enviar Solicitud';
      }
    });
  }
</script>
