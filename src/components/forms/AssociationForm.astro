---
import Honeypot from './Honeypot.astro';
import { createTranslator, getLangFromUrl, localizePath } from '../../i18n';
import { asociate } from '../../i18n/asociate';

const lang = getLangFromUrl(Astro.url);
const t = createTranslator(asociate, lang);
---

<form
  method="POST"
  action="/api/associate"
  class="relative space-y-6"
  data-thanks-url={localizePath('/asociate/gracias', lang)}
  data-submit={t('form.submit')}
  data-sending={t('form.sending')}
  data-error={t('form.error')}
  data-connection-error={t('form.connectionError')}
>
  <Honeypot />
  <!-- Idioma de la página: el de las respuestas del servidor y el del correo de bienvenida -->
  <input type="hidden" name="lang" value={lang} />
  <div>
    <label for="name" class="mb-2 block text-sm font-semibold text-gray-700">
      {t('field.name')} <span class="text-red-500">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder={t('field.namePlaceholder')}
      aria-required="true"
    />
  </div>

  <div>
    <label for="email" class="mb-2 block text-sm font-semibold text-gray-700">
      {t('field.email')} <span class="text-red-500">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder={t('field.emailPlaceholder')}
      aria-required="true"
    />
  </div>

  <div>
    <label for="phone" class="mb-2 block text-sm font-semibold text-gray-700">
      {t('field.phone')}
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder="+34 600 000 000"
    />
    <p class="mt-1 text-sm text-gray-500">{t('field.phoneHelp')}</p>
  </div>

  <div>
    <label for="message" class="mb-2 block text-sm font-semibold text-gray-700">
      {t('field.message')}
    </label>
    <textarea
      id="message"
      name="message"
      rows="4"
      maxlength="500"
      class="w-full resize-none rounded-lg border border-gray-300 px-4 py-3 outline-none transition-colors focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
      placeholder={t('field.messagePlaceholder')}
    ></textarea>
    <p class="mt-1 text-sm text-gray-500">{t('field.messageHelp')}</p>
  </div>

  <div id="form-message" class="hidden rounded-lg p-4"></div>

  <button type="submit" class="btn-primary w-full py-4 text-lg" id="submit-button">
    {t('form.submit')}
  </button>

  <p class="text-center text-sm text-gray-600">{t('form.consent')}</p>
</form>

<script>
  const form = document.querySelector('form');
  const formMessage = document.getElementById('form-message');
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;

  if (form && formMessage && submitButton) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      submitButton.disabled = true;
      submitButton.textContent = form.dataset.sending ?? '';
      formMessage.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
        });

        const result = (await response.json()) as { success?: boolean; error?: string };

        formMessage.classList.remove('hidden');

        if (result.success) {
          // Redirigir a la página de gracias
          window.location.href = form.dataset.thanksUrl ?? '/asociate/gracias';
          return;
        } else {
          formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
          formMessage.textContent = result.error || form.dataset.error || '';
        }
      } catch (error) {
        formMessage.classList.remove('hidden');
        formMessage.className = 'p-4 rounded-lg bg-red-50 text-red-800 border border-red-200';
        formMessage.textContent = form.dataset.connectionError ?? '';
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = form.dataset.submit ?? '';
        }
      }
    });
  }
</script>
