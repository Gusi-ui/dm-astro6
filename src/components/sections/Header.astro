---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/asociacion', label: 'Asociación' },
  { href: '/blog', label: 'Blog', matchPrefix: true },
  { href: '/documentos', label: 'Documentos' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header
  class="fixed left-0 right-0 top-0 z-50 border-b border-primary-200/20 bg-white/90 shadow-2xl shadow-primary-500/5 backdrop-blur-xl"
>
  <!-- Gradiente decorativo superior -->
  <div
    class="absolute left-0 right-0 top-0 h-1 bg-gradient-to-r from-primary-500 via-accent-500 to-primary-500 opacity-60"
  >
  </div>

  <nav class="section-container py-3" aria-label="Navegación principal">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="group relative flex items-center transition-all duration-300">
        <img
          src="/logoDiverMataro.png"
          alt="Diversidad Funcional Mataró"
          class="h-12 w-auto md:h-14"
        />
        <!-- Título oculto visualmente pero presente para SEO -->
        <span class="sr-only">Diversidad Funcional Mataró</span>
        <div
          class="absolute -inset-2 rounded-lg bg-gradient-to-r from-primary-400/20 to-accent-400/20 opacity-0 blur-lg transition-opacity duration-300 group-hover:opacity-100"
        >
        </div>
      </a>

      <!-- Desktop Navigation -->
      <ul class="hidden items-center gap-2 md:flex">
        {
          navItems.map(({ href, label, matchPrefix }) => {
            const isActive = matchPrefix
              ? currentPath.startsWith(href) && href !== '/'
              : currentPath === href;

            return (
              <li>
                <a href={href} class="group relative" aria-current={isActive ? 'page' : undefined}>
                  <div class="relative">
                    {/* Glow effect */}
                    <div
                      class={`absolute -inset-2 rounded-xl bg-gradient-to-r from-primary-400 to-accent-400 blur-lg transition-opacity duration-500 ${
                        isActive ? 'opacity-40' : 'opacity-0 group-hover:opacity-40'
                      }`}
                    />

                    {/* Link container */}
                    <div
                      class={`relative rounded-xl border px-4 py-2.5 shadow-md transition-all duration-500 group-hover:shadow-xl ${
                        isActive
                          ? 'border-primary-400/70 bg-gradient-to-br from-primary-50 to-accent-50 shadow-lg'
                          : 'border-white/70 bg-gradient-to-br from-white to-primary-50/30'
                      }`}
                    >
                      <span
                        class={`whitespace-nowrap text-base font-semibold transition-colors duration-300 ${
                          isActive
                            ? 'text-primary-600'
                            : 'text-gray-800 group-hover:text-primary-600'
                        }`}
                      >
                        {label}
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            );
          })
        }

        <li>
          <a href="/asociate" class="btn-primary ml-2"> Únete </a>
        </li>
      </ul>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="rounded-lg p-2 text-gray-700 transition-colors hover:bg-primary-50 hover:text-primary-600 md:hidden"
        aria-label="Menú móvil"
        aria-expanded="false"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu con animación -->
    <div id="mobile-menu" class="mobile-menu-container mt-4 hidden pb-4 md:hidden">
      <ul class="flex flex-col gap-3">
        {
          (() => {
            // Colores únicos para cada ítem
            const itemColors = [
              {
                bg: 'from-cyan-500 to-blue-500',
                border: 'border-cyan-400',
                shadow: 'shadow-cyan-500/30',
                hover:
                  'hover:border-cyan-300 hover:from-cyan-50 hover:to-blue-50 hover:text-cyan-600',
              },
              {
                bg: 'from-orange-500 to-amber-500',
                border: 'border-orange-400',
                shadow: 'shadow-orange-500/30',
                hover:
                  'hover:border-orange-300 hover:from-orange-50 hover:to-amber-50 hover:text-orange-600',
              },
              {
                bg: 'from-pink-500 to-rose-500',
                border: 'border-pink-400',
                shadow: 'shadow-pink-500/30',
                hover:
                  'hover:border-pink-300 hover:from-pink-50 hover:to-rose-50 hover:text-pink-600',
              },
              {
                bg: 'from-emerald-500 to-teal-500',
                border: 'border-emerald-400',
                shadow: 'shadow-emerald-500/30',
                hover:
                  'hover:border-emerald-300 hover:from-emerald-50 hover:to-teal-50 hover:text-emerald-600',
              },
              {
                bg: 'from-violet-500 to-purple-500',
                border: 'border-violet-400',
                shadow: 'shadow-violet-500/30',
                hover:
                  'hover:border-violet-300 hover:from-violet-50 hover:to-purple-50 hover:text-violet-600',
              },
            ];

            return navItems.map(({ href, label, matchPrefix }, index) => {
              const isActive = matchPrefix
                ? currentPath.startsWith(href) && href !== '/'
                : currentPath === href;
              const color = itemColors[index % itemColors.length];

              return (
                <li class="mobile-menu-item" style={`--item-delay: ${index * 0.2}s`}>
                  <a
                    href={href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`block rounded-xl border px-4 py-3 shadow-sm transition-all duration-300 ${
                      isActive
                        ? `${color.border} bg-gradient-to-r ${color.bg} font-semibold text-white shadow-lg ${color.shadow}`
                        : `border-transparent bg-gradient-to-r from-gray-50 to-white text-gray-700 ${color.hover} hover:shadow-md`
                    }`}
                  >
                    {label}
                  </a>
                </li>
              );
            });
          })()
        }
        <li class="mobile-menu-item" style={`--item-delay: ${navItems.length * 0.2}s`}>
          <a href="/asociate" class="btn-primary w-full text-center"> Únete </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  if (mobileMenuButton && mobileMenu) {
    mobileMenuButton.addEventListener('click', () => {
      const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
      mobileMenuButton.setAttribute('aria-expanded', String(!isExpanded));

      if (isExpanded) {
        // Cerrar menú con animación
        mobileMenu.classList.add('menu-closing');
        mobileMenu.classList.remove('menu-open');
        setTimeout(() => {
          mobileMenu.classList.add('hidden');
          mobileMenu.classList.remove('menu-closing');
        }, 300);
      } else {
        // Abrir menú con animación
        mobileMenu.classList.remove('hidden');
        // Pequeño delay para que el navegador procese el cambio de display
        requestAnimationFrame(() => {
          mobileMenu.classList.add('menu-open');
        });
      }
    });
  }
</script>

<style>
  /* Animación del contenedor del menú móvil */
  .mobile-menu-container {
    opacity: 0;
    transform: translateY(-20px);
    transition:
      opacity 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .mobile-menu-container.menu-open {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu-container.menu-closing {
    opacity: 0;
    transform: translateY(-10px);
  }

  /* Animación escalonada de los items */
  .mobile-menu-item {
    opacity: 0;
    transform: translateX(-20px);
    transition:
      opacity 0.4s ease-out,
      transform 0.4s ease-out;
    transition-delay: var(--item-delay, 0s);
  }

  .menu-open .mobile-menu-item {
    opacity: 1;
    transform: translateX(0);
  }

  .menu-closing .mobile-menu-item {
    opacity: 0;
    transform: translateX(-10px);
    transition-delay: 0s;
  }
</style>
