---
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  getImageSizes,
  getImageSrcSet,
  isCloudinarySource,
  resolveImageSrc,
} from '../../lib/cloudinary';

type BlogEntry = CollectionEntry<'blog'>;

// Obtener todos los posts publicados
const allPosts = await getCollection('blog', (entry: BlogEntry) => {
  return entry.data.pubDate <= new Date();
});

// Función para mezclar aleatoriamente (Fisher-Yates shuffle)
function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

// Obtener 3 posts aleatorios
const randomPosts: BlogEntry[] = shuffleArray(allPosts).slice(0, 3);

// Colores para las tarjetas
const cardColors = [
  {
    gradient: 'from-primary-500 to-cyan-500',
    shadow: 'shadow-primary-500/20',
    categoryBg: 'bg-primary-100',
    categoryText: 'text-primary-700',
    hoverBorder: 'hover:border-primary-400',
  },
  {
    gradient: 'from-accent-500 to-pink-500',
    shadow: 'shadow-accent-500/20',
    categoryBg: 'bg-accent-100',
    categoryText: 'text-accent-700',
    hoverBorder: 'hover:border-accent-400',
  },
  {
    gradient: 'from-orange-400 to-amber-500',
    shadow: 'shadow-orange-500/20',
    categoryBg: 'bg-orange-100',
    categoryText: 'text-orange-700',
    hoverBorder: 'hover:border-orange-400',
  },
];
---

<section
  id="blog"
  class="relative overflow-hidden bg-gradient-to-b from-white to-gray-50 py-20 md:py-28"
>
  <!-- Decoración de fondo -->
  <div
    class="absolute right-0 top-0 h-96 w-96 -translate-y-1/2 translate-x-1/2 rounded-full bg-gradient-to-br from-primary-200/40 to-accent-200/40 blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 h-72 w-72 -translate-x-1/2 translate-y-1/2 rounded-full bg-gradient-to-br from-accent-200/40 to-primary-200/40 blur-3xl"
  >
  </div>

  <!-- Patrón decorativo -->
  <div
    class="absolute inset-0 opacity-[0.02]"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23000000' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"
  >
  </div>

  <div class="section-container relative">
    <!-- Encabezado -->
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-4 py-2 text-sm font-semibold text-primary-700"
      >
        Nuestro Blog
      </span>
      <h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">
        Últimas
        <span class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent">
          noticias
        </span>
      </h2>
      <p class="text-lg text-gray-600 md:text-xl">
        Descubre nuestras historias, logros y las reivindicaciones que llevamos adelante cada día.
      </p>
    </div>

    <!-- Grid de posts -->
    {
      randomPosts.length > 0 ? (
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          {randomPosts.map((post, index) => {
            const slug = post.id || post.slug;
            const colors = cardColors[index];
            return (
              <a
                href={`/blog/${slug}`}
                class={`group relative flex flex-col overflow-hidden rounded-3xl border-2 border-gray-100 bg-white shadow-xl transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl ${colors.hoverBorder}`}
              >
                {/* Imagen del post */}
                <div class="relative h-52 overflow-hidden">
                  {post.data.heroImage ? (
                    <img
                      src={resolveImageSrc(post.data.heroImage, 'thumbnail')}
                      srcset={
                        isCloudinarySource(post.data.heroImage)
                          ? getImageSrcSet(post.data.heroImage, 'thumbnail')
                          : undefined
                      }
                      sizes={
                        isCloudinarySource(post.data.heroImage)
                          ? getImageSizes('thumbnail')
                          : undefined
                      }
                      alt={post.data.title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class={`h-full w-full bg-gradient-to-br ${colors.gradient}`} />
                  )}

                  {/* Overlay con gradiente */}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent opacity-60 transition-opacity duration-300 group-hover:opacity-40" />

                  {/* Categoría flotante */}
                  {post.data.category && (
                    <span
                      class={`absolute left-4 top-4 rounded-full ${colors.categoryBg} px-3 py-1 text-xs font-semibold ${colors.categoryText} shadow-lg backdrop-blur-sm`}
                    >
                      {post.data.category}
                    </span>
                  )}

                  {/* Fecha flotante */}
                  <div class="absolute bottom-4 left-4 flex items-center text-white/90">
                    <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                      />
                    </svg>
                    <span class="text-sm font-medium">
                      {post.data.pubDate.toLocaleDateString('es-ES', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                  </div>
                </div>

                {/* Contenido */}
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="mb-3 line-clamp-2 text-xl font-bold text-gray-900 transition-colors duration-300 group-hover:text-primary-600">
                    {post.data.title}
                  </h3>
                  <p class="mb-4 line-clamp-3 flex-1 leading-relaxed text-gray-600">
                    {post.data.description}
                  </p>

                  {/* Link para leer más */}
                  <div class="flex items-center font-semibold text-primary-600">
                    <span class="text-sm">Leer artículo</span>
                    <svg
                      class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:translate-x-2"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"
                      />
                    </svg>
                  </div>
                </div>

                {/* Efecto de brillo en hover */}
                <div class="absolute -right-20 -top-20 h-40 w-40 rounded-full bg-white/20 opacity-0 blur-3xl transition-opacity duration-500 group-hover:opacity-100" />
              </a>
            );
          })}
        </div>
      ) : (
        <div class="py-12 text-center">
          <p class="text-lg text-gray-600">Próximamente publicaremos contenido aquí.</p>
        </div>
      )
    }

    <!-- Botón para ver más -->
    <div class="mt-16 text-center">
      <a
        href="/blog"
        class="group inline-flex items-center rounded-2xl border-2 border-gray-200 bg-white px-8 py-4 font-bold text-gray-900 shadow-lg transition-all duration-300 hover:border-primary-400 hover:bg-gradient-to-r hover:from-primary-600 hover:to-accent-600 hover:text-white hover:shadow-xl hover:shadow-primary-500/30"
      >
        <span>Ver todos los artículos</span>
        <svg
          class="ml-3 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
