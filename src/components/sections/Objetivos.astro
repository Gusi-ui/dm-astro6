---
import { createTranslator, getLangFromUrl } from '../../i18n';
import { home } from '../../i18n/home';

const t = createTranslator(home, getLangFromUrl(Astro.url));
---

<section id="objetivos" class="bg-primary-50 py-16 md:py-24">
  <div class="section-container">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900 md:text-4xl">
        {t('goals.title')}
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="rounded-xl bg-white p-6 shadow-md">
          <h3 class="mb-4 text-xl font-semibold text-primary-600">{t('goals.goals')}</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>{t('goals.goal1')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>{t('goals.goal2')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>{t('goals.goal3')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>{t('goals.goal4')}</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-md">
          <h3 class="mb-4 text-xl font-semibold text-accent-600">{t('goals.values')}</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>{t('goals.value1')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>{t('goals.value2')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>{t('goals.value3')}</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>{t('goals.value4')}</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
