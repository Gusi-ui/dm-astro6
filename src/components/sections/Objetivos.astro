<section id="objetivos" class="py-16 md:py-24 bg-primary-50">
  <div class="section-container">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">
        Objetivos y Valores
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl p-6 shadow-md">
          <h3 class="text-xl font-semibold mb-4 text-primary-600">Nuestros Objetivos</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-primary-600 mr-2">✓</span>
              <span>Conseguir accesibilidad universal en Mataró</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary-600 mr-2">✓</span>
              <span>Defender los derechos humanos de las personas con diversidad funcional</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary-600 mr-2">✓</span>
              <span>Promover la participación ciudadana activa</span>
            </li>
            <li class="flex items-start">
              <span class="text-primary-600 mr-2">✓</span>
              <span>Crear una red de apoyo y solidaridad</span>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-xl p-6 shadow-md">
          <h3 class="text-xl font-semibold mb-4 text-accent-600">Nuestros Valores</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="text-accent-600 mr-2">✓</span>
              <span>Solidaridad y apoyo mutuo</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent-600 mr-2">✓</span>
              <span>Trabajo voluntario y altruista</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent-600 mr-2">✓</span>
              <span>Transparencia en nuestras acciones</span>
            </li>
            <li class="flex items-start">
              <span class="text-accent-600 mr-2">✓</span>
              <span>Compromiso con la inclusión</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
