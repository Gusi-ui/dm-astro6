<section id="objetivos" class="bg-primary-50 py-16 md:py-24">
  <div class="section-container">
    <div class="mx-auto max-w-4xl">
      <h2 class="mb-12 text-center text-3xl font-bold text-gray-900 md:text-4xl">
        Objetivos y Valores
      </h2>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <div class="rounded-xl bg-white p-6 shadow-md">
          <h3 class="mb-4 text-xl font-semibold text-primary-600">Nuestros Objetivos</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>Conseguir accesibilidad universal en Mataró</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>Defender los derechos humanos de las personas con diversidad funcional</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>Promover la participación ciudadana activa</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-primary-600">✓</span>
              <span>Crear una red de apoyo y solidaridad</span>
            </li>
          </ul>
        </div>

        <div class="rounded-xl bg-white p-6 shadow-md">
          <h3 class="mb-4 text-xl font-semibold text-accent-600">Nuestros Valores</h3>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>Solidaridad y apoyo mutuo</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>Trabajo voluntario y altruista</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>Transparencia en nuestras acciones</span>
            </li>
            <li class="flex items-start">
              <span class="mr-2 text-accent-600">✓</span>
              <span>Compromiso con la inclusión</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
