---
import { getCollection } from 'astro:content';

// Obtener todos los posts para contar por categoría
const allPosts = await getCollection('blog');

// Función para contar posts por categoría
function countPostsByCategory(category: string): number {
  return allPosts.filter((post) => post.data.category?.toLowerCase() === category.toLowerCase())
    .length;
}

const reivindicaciones = [
  {
    title: 'Accesibilidad en el Transporte',
    description:
      'Reivindicamos un transporte público 100% accesible para todas las personas, con paradas adaptadas, vehículos con rampas y espacios reservados. Cada día miles de personas encuentran barreras para moverse por nuestra ciudad.',
    category: 'Transporte',
    color: 'bg-primary-500',
    colorLight: 'bg-primary-50',
    colorText: 'text-primary-600',
    hoverBg: 'hover:bg-primary-50',
  },
  {
    title: 'Accesibilidad en Espacios Públicos',
    description:
      'Trabajamos para que todos los espacios públicos, parques, plazas y edificios municipales sean completamente accesibles. La ciudad debe ser de todos y para todos, sin barreras arquitectónicas que limiten la participación.',
    category: 'Accesibilidad',
    color: 'bg-accent-500',
    colorLight: 'bg-accent-50',
    colorText: 'text-accent-600',
    hoverBg: 'hover:bg-accent-50',
  },
  {
    title: 'Educación Inclusiva',
    description:
      'Defendemos una educación inclusiva que garantice el acceso y la participación de todos los estudiantes. Cada niño y niña merece las mismas oportunidades de aprendizaje y desarrollo.',
    category: 'Social',
    color: 'bg-green-500',
    colorLight: 'bg-green-50',
    colorText: 'text-green-600',
    hoverBg: 'hover:bg-green-50',
  },
  {
    title: 'Denuncias y Visibilización',
    description:
      'Trabajamos para visibilizar las injusticias y barreras que encontramos cada día. Denunciamos públicamente las situaciones de discriminación y falta de accesibilidad.',
    category: 'Denuncia',
    color: 'bg-rose-500',
    colorLight: 'bg-rose-50',
    colorText: 'text-rose-600',
    hoverBg: 'hover:bg-rose-50',
  },
];

// Añadir conteo de posts a cada reivindicación y ordenar de mayor a menor
const reivindicacionesConConteo = reivindicaciones
  .map((r) => ({
    ...r,
    postCount: countPostsByCategory(r.category),
  }))
  .sort((a, b) => b.postCount - a.postCount);

// Calcular años desde la fundación de la asociación
const ANIO_FUNDACION = 2019;
const aniosLuchando = new Date().getFullYear() - ANIO_FUNDACION;
---

<section id="reivindicaciones" class="relative overflow-hidden bg-white py-20 md:py-28">
  <!-- Decoración de fondo -->
  <div
    class="absolute left-0 top-1/4 h-96 w-96 -translate-x-1/2 rounded-full bg-gradient-to-br from-primary-100/60 to-accent-100/60 blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 right-0 h-72 w-72 translate-x-1/2 rounded-full bg-gradient-to-br from-accent-100/60 to-primary-100/60 blur-3xl"
  >
  </div>

  <div class="section-container relative">
    <!-- Encabezado -->
    <div class="mx-auto mb-16 max-w-3xl text-center">
      <span
        class="mb-4 inline-block rounded-full bg-gradient-to-r from-primary-100 to-accent-100 px-4 py-2 text-sm font-semibold text-primary-700"
      >
        Por lo que luchamos
      </span>
      <h2 class="mb-6 text-4xl font-bold text-gray-900 md:text-5xl">
        Nuestras
        <span class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent">
          reivindicaciones
        </span>
      </h2>
      <p class="text-lg text-gray-600 md:text-xl">
        Trabajamos en diferentes ámbitos para conseguir una sociedad más accesible e inclusiva. Cada
        lucha cuenta.
      </p>
    </div>

    <!-- Lista de reivindicaciones -->
    <div class="mx-auto max-w-4xl">
      <div
        class="divide-y divide-gray-100 rounded-3xl border border-gray-100 bg-white shadow-xl shadow-gray-200/50"
      >
        {
          reivindicacionesConConteo.map((item, index) => (
            <div class="reivindicacion-item group" data-index={index}>
              <button
                class={`flex w-full items-center gap-4 p-6 text-left transition-all duration-300 ${item.hoverBg} md:p-8`}
                aria-expanded="false"
                aria-controls={`content-${index}`}
              >
                {/* Barra de color */}
                <div
                  class={`hidden h-16 w-1.5 flex-shrink-0 rounded-full ${item.color} transition-all duration-300 group-hover:h-20 sm:block`}
                />

                {/* Contenido principal */}
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-bold text-gray-900 transition-colors duration-300 group-hover:text-gray-700 md:text-xl">
                    {item.title}
                  </h3>
                  <p class="mt-1 line-clamp-1 text-sm text-gray-500 md:text-base">
                    {item.description.substring(0, 80)}...
                  </p>
                </div>

                {/* Contador de posts y flecha */}
                <div class="flex flex-shrink-0 items-center gap-3">
                  {item.postCount > 0 && (
                    <span
                      class={`hidden rounded-full ${item.colorLight} px-3 py-1 text-sm font-semibold ${item.colorText} sm:inline-flex`}
                    >
                      {item.postCount} {item.postCount === 1 ? 'artículo' : 'artículos'}
                    </span>
                  )}
                  <div
                    class={`flex h-10 w-10 items-center justify-center rounded-full ${item.colorLight} transition-all duration-300`}
                  >
                    <svg
                      class={`h-5 w-5 ${item.colorText} expand-icon transition-transform duration-300`}
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"
                      />
                    </svg>
                  </div>
                </div>
              </button>

              {/* Contenido expandible */}
              <div
                id={`content-${index}`}
                class="expandable-content overflow-hidden transition-all duration-500"
                style="max-height: 0; opacity: 0;"
              >
                <div
                  class={`px-6 pb-6 md:px-8 md:pb-8 ${item.colorLight} mx-4 mb-4 rounded-2xl md:mx-6`}
                >
                  <div class="flex flex-col gap-4 pt-4 sm:flex-row sm:items-start sm:gap-6">
                    {/* Descripción completa */}
                    <div class="flex-1">
                      <p class="leading-relaxed text-gray-700">{item.description}</p>
                    </div>

                    {/* Botón para ver artículos */}
                    {item.postCount > 0 && (
                      <a
                        href={`/blog/categoria/${item.category.toLowerCase()}`}
                        class={`inline-flex items-center justify-center gap-2 rounded-xl ${item.color} flex-shrink-0 px-5 py-3 font-semibold text-white shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-xl`}
                      >
                        <span>Ver artículos</span>
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 7l5 5m0 0l-5 5m5-5H6"
                          />
                        </svg>
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Estadísticas -->
    <div class="mt-16 grid grid-cols-2 gap-4 sm:grid-cols-4 md:gap-8">
      <div class="rounded-2xl bg-gradient-to-br from-primary-50 to-primary-100/50 p-6 text-center">
        <div class="text-3xl font-bold text-primary-600 md:text-4xl">4</div>
        <div class="mt-1 text-sm text-gray-600">Áreas de acción</div>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-accent-50 to-accent-100/50 p-6 text-center">
        <div class="text-3xl font-bold text-accent-600 md:text-4xl">{allPosts.length}</div>
        <div class="mt-1 text-sm text-gray-600">Artículos publicados</div>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-orange-50 to-orange-100/50 p-6 text-center">
        <div class="text-3xl font-bold text-orange-600 md:text-4xl">+{aniosLuchando}</div>
        <div class="mt-1 text-sm text-gray-600">Años luchando</div>
      </div>
      <div class="rounded-2xl bg-gradient-to-br from-green-50 to-green-100/50 p-6 text-center">
        <div class="text-3xl font-bold text-green-600 md:text-4xl">100%</div>
        <div class="mt-1 text-sm text-gray-600">Voluntarios</div>
      </div>
    </div>
  </div>
</section>

<script>
  // Acordeón expandible
  document.querySelectorAll('.reivindicacion-item button').forEach((button) => {
    button.addEventListener('click', () => {
      const item = button.closest('.reivindicacion-item');
      const content = item?.querySelector('.expandable-content') as HTMLElement;
      const icon = button.querySelector('.expand-icon');
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      // Cerrar otros items abiertos
      document.querySelectorAll('.reivindicacion-item').forEach((otherItem) => {
        if (otherItem !== item) {
          const otherButton = otherItem.querySelector('button');
          const otherContent = otherItem.querySelector('.expandable-content') as HTMLElement;
          const otherIcon = otherItem.querySelector('.expand-icon');

          if (otherButton?.getAttribute('aria-expanded') === 'true') {
            otherButton.setAttribute('aria-expanded', 'false');
            if (otherContent) {
              otherContent.style.maxHeight = '0';
              otherContent.style.opacity = '0';
            }
            otherIcon?.classList.remove('rotate-180');
          }
        }
      });

      // Toggle el item actual
      if (isExpanded) {
        button.setAttribute('aria-expanded', 'false');
        content.style.maxHeight = '0';
        content.style.opacity = '0';
        icon?.classList.remove('rotate-180');
      } else {
        button.setAttribute('aria-expanded', 'true');
        content.style.maxHeight = content.scrollHeight + 'px';
        content.style.opacity = '1';
        icon?.classList.add('rotate-180');
      }
    });
  });
</script>
