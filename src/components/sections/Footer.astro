---
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();

// Colores idénticos al header — cada página tiene su identidad cromática
const navLinks = [
  {
    href: '/',
    label: 'Inicio',
    matchPrefix: false,
    activeColor: 'text-cyan-200',
    border: 'border-cyan-400/50',
    glow: 'from-cyan-400 to-blue-400',
    hoverBg: 'hover:bg-cyan-400/10',
    hoverText: 'hover:text-cyan-300',
  },
  {
    href: '/asociacion',
    label: 'Asociación',
    matchPrefix: false,
    activeColor: 'text-orange-200',
    border: 'border-orange-400/50',
    glow: 'from-orange-400 to-amber-400',
    hoverBg: 'hover:bg-orange-400/10',
    hoverText: 'hover:text-orange-300',
  },
  {
    href: '/blog',
    label: 'Blog',
    matchPrefix: true,
    activeColor: 'text-pink-200',
    border: 'border-pink-400/50',
    glow: 'from-pink-400 to-rose-400',
    hoverBg: 'hover:bg-pink-400/10',
    hoverText: 'hover:text-pink-300',
  },
  {
    href: '/documentos',
    label: 'Documentos',
    matchPrefix: false,
    activeColor: 'text-emerald-200',
    border: 'border-emerald-400/50',
    glow: 'from-emerald-400 to-teal-400',
    hoverBg: 'hover:bg-emerald-400/10',
    hoverText: 'hover:text-emerald-300',
  },
  {
    href: '/contacto',
    label: 'Contacto',
    matchPrefix: false,
    activeColor: 'text-violet-200',
    border: 'border-violet-400/50',
    glow: 'from-violet-400 to-purple-400',
    hoverBg: 'hover:bg-violet-400/10',
    hoverText: 'hover:text-violet-300',
  },
];

// Colores consistentes con las tarjetas de Servicios.astro
const serviceLinks = [
  {
    href: '/servicios/apoyo-personalizado',
    label: 'Apoyo Personalizado',
    hoverBg: 'hover:bg-orange-400/10',
    hoverText: 'hover:text-orange-300',
  },
  {
    href: '/servicios/comunidad-inclusiva',
    label: 'Comunidad Inclusiva',
    hoverBg: 'hover:bg-cyan-400/10',
    hoverText: 'hover:text-cyan-300',
  },
  {
    href: '/servicios/actos-reivindicativos',
    label: 'Actos Reivindicativos',
    hoverBg: 'hover:bg-pink-400/10',
    hoverText: 'hover:text-pink-300',
  },
  {
    href: '/servicios/reconocimiento-social',
    label: 'Reconocimiento Social',
    hoverBg: 'hover:bg-amber-400/10',
    hoverText: 'hover:text-amber-300',
  },
  {
    href: '/servicios/accesibilidad-universal',
    label: 'Accesibilidad Universal',
    hoverBg: 'hover:bg-emerald-400/10',
    hoverText: 'hover:text-emerald-300',
  },
  {
    href: '/servicios/innovacion-constante',
    label: 'Innovación Constante',
    hoverBg: 'hover:bg-violet-400/10',
    hoverText: 'hover:text-violet-300',
  },
];
---

<footer
  class="relative overflow-hidden bg-gradient-to-br from-primary-800 via-primary-900 to-accent-900"
>
  <!-- Línea decorativa superior — espejo del gradiente del header -->
  <div class="h-1 bg-gradient-to-r from-primary-400 via-accent-400 to-primary-400 opacity-70"></div>

  <!-- Efecto de brillo ambiental decorativo (estáticos, sin hover) -->
  <div
    class="pointer-events-none absolute -left-40 top-0 h-80 w-80 rounded-full bg-primary-500/10 blur-3xl"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-40 bottom-20 h-96 w-96 rounded-full bg-accent-500/10 blur-3xl"
  >
  </div>

  <div class="section-container relative pb-0 pt-16">
    <!-- ═══ Top: Logo + Misión + Redes Sociales ═══ -->
    <div
      class="mb-12 flex flex-col items-center gap-8 md:flex-row md:items-start md:justify-between"
    >
      <!-- Logo + Misión -->
      <div class="text-center md:max-w-md md:text-left">
        <a href="/" class="mb-4 inline-block" aria-label="Ir al inicio">
          <img
            src="/logoDiverMataro.png"
            alt="Diversidad Funcional Mataró"
            class="h-16 w-auto brightness-0 drop-shadow-[0_2px_12px_rgba(56,189,248,0.4)] hue-rotate-[180deg] invert saturate-[5] sepia-[0.35]"
          />
        </a>
        <p class="mt-4 text-base leading-relaxed text-white/80">
          Trabajamos de manera altruista y sin ánimo de lucro por una sociedad con accesibilidad
          universal, inclusión plena e integración real en Mataró.
        </p>
      </div>

      <!-- Redes Sociales — cada icono tiene hover individual con su color de marca -->
      <div class="flex flex-col items-center gap-3 md:items-end">
        <span class="text-sm font-semibold uppercase tracking-widest text-white/50">Síguenos</span>
        <div class="flex items-center gap-4">
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/groups/562043394553536/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon social-facebook"
            aria-label="Facebook"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
              ></path>
            </svg>
          </a>
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/divermataro/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon social-instagram"
            aria-label="Instagram"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
              ></path>
            </svg>
          </a>
          <!-- YouTube -->
          <a
            href="https://www.youtube.com/@divermataro"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon social-youtube"
            aria-label="YouTube"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
              ></path>
            </svg>
          </a>
          <!-- X (Twitter) -->
          <a
            href="https://x.com/DiverMataro"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon social-x"
            aria-label="X (Twitter)"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
              ></path>
            </svg>
          </a>
          <!-- WhatsApp -->
          <a
            href="https://wa.me/34674506080"
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon social-whatsapp"
            aria-label="WhatsApp"
          >
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Separador gradiente -->
    <div class="mb-12 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"></div>

    <!-- ═══ Grid principal: Navega + Servicios + Contacto + Mapa ═══ -->
    <div class="mb-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Navegación — colores únicos por enlace como el header -->
      <nav aria-label="Navegación del footer">
        <h4 class="footer-heading">
          <span
            class="mr-2 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-primary-400 to-cyan-400"
          ></span>
          Navega
        </h4>
        <ul class="space-y-1">
          {
            navLinks.map((link) => {
              const isActive = link.matchPrefix
                ? currentPath.startsWith(link.href) && link.href !== '/'
                : currentPath === link.href;

              return (
                <li>
                  <a
                    href={link.href}
                    class={`group relative flex items-center rounded-lg px-3 py-2 text-base font-medium transition-all duration-300 ${link.hoverBg} ${link.hoverText} ${
                      isActive
                        ? `${link.activeColor} ${link.border} border bg-white/10`
                        : 'text-white/70'
                    }`}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {/* Glow en activo */}
                    {isActive && (
                      <div
                        class={`pointer-events-none absolute -inset-0.5 rounded-lg bg-gradient-to-r ${link.glow} opacity-20 blur-sm`}
                      />
                    )}
                    <span class="relative flex items-center gap-2">
                      <span
                        class={`inline-block h-1.5 w-1.5 rounded-full transition-all duration-300 ${
                          isActive
                            ? 'scale-125 bg-current'
                            : 'bg-white/30 group-hover:scale-125 group-hover:bg-current'
                        }`}
                      />
                      {link.label}
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <!-- Servicios — colores consistentes con tarjetas de Servicios.astro -->
      <nav aria-label="Servicios">
        <h4 class="footer-heading">
          <span
            class="mr-2 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-accent-400 to-pink-400"
          ></span>
          Servicios
        </h4>
        <ul class="space-y-1">
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class={`group flex items-center rounded-lg px-3 py-2 text-base font-medium text-white/70 transition-all duration-300 ${link.hoverBg} ${link.hoverText}`}
                >
                  <span class="mr-2 inline-block h-1.5 w-1.5 rounded-full bg-white/30 transition-all duration-300 group-hover:scale-125 group-hover:bg-current" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contacto -->
      <div>
        <h4 class="footer-heading">
          <span
            class="mr-2 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-emerald-400 to-green-400"
          ></span>
          Contacto
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="mailto:info@divermataro.org"
              class="contact-card hover:border-primary-400/30 hover:bg-primary-400/10"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-primary-400 to-cyan-500 shadow-lg shadow-primary-500/20"
              >
                <svg
                  class="h-4 w-4 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </span>
              <div class="min-w-0">
                <p class="text-sm text-white/50">Email</p>
                <p class="truncate text-base font-medium text-white/90">info@divermataro.org</p>
              </div>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/34674506080"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-card hover:border-green-400/30 hover:bg-green-400/10"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-green-400 to-emerald-500 shadow-lg shadow-green-500/20"
              >
                <svg class="h-4 w-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                  ></path>
                </svg>
              </span>
              <div>
                <p class="text-sm text-white/50">WhatsApp</p>
                <p class="text-base font-medium text-white/90">+34 674 50 60 80</p>
              </div>
            </a>
          </li>
          <li>
            <div
              class="flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3"
            >
              <span
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-violet-400 to-purple-500 shadow-lg shadow-violet-500/20"
              >
                <svg
                  class="h-4 w-4 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </span>
              <div>
                <p class="text-sm text-white/50">Ubicación</p>
                <p class="text-base font-medium text-white/90">Mataró, Barcelona</p>
              </div>
            </div>
          </li>
        </ul>
      </div>

      <!-- Mapa -->
      <div>
        <h4 class="footer-heading">
          <span
            class="mr-2 inline-block h-2 w-2 rounded-full bg-gradient-to-r from-amber-400 to-orange-400"
          ></span>
          Encuéntranos
        </h4>
        <div
          class="overflow-hidden rounded-2xl border border-white/20 shadow-lg shadow-black/20 transition-all duration-500 hover:border-primary-400/30 hover:shadow-xl"
        >
          <iframe
            src="https://maps.google.com/maps?width=100%25&height=200&hl=es&q=Matar%C3%B3,Barcelona&t=&z=14&ie=UTF8&iwloc=B&output=embed"
            class="h-48 w-full opacity-80 transition-opacity duration-500 hover:opacity-100"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de DiverMataró en Mataró, Barcelona"
            style="border:0;"></iframe>
        </div>
      </div>
    </div>

    <!-- ═══ CTA strip — sin group, hover solo en el botón ═══ -->
    <div
      class="relative mb-8 overflow-hidden rounded-2xl border border-white/20 bg-white/10 px-6 py-8 text-center backdrop-blur-lg"
    >
      <!-- Glow decorativo estático -->
      <div
        class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-gradient-to-br from-accent-400/20 to-primary-400/20 blur-2xl"
      >
      </div>
      <p class="relative mb-1 text-lg font-bold text-white">¿Quieres ser parte del cambio?</p>
      <p class="relative mb-5 text-base text-white/70">
        No cobramos ningún tipo de cuota &middot; Todo es voluntario
      </p>
      <a
        href="/asociate"
        class="group relative inline-flex transform items-center justify-center rounded-2xl bg-white px-8 py-3 font-bold text-primary-700 shadow-xl transition-all duration-300 hover:scale-105 hover:bg-primary-50 hover:shadow-2xl"
      >
        Asóciate Gratis
        <svg
          class="ml-2 h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>

    <!-- ═══ Bottom bar ═══ -->
    <div class="border-t border-white/15 py-6">
      <div
        class="flex flex-col items-center justify-between gap-3 text-center sm:flex-row sm:text-left"
      >
        <p class="text-sm text-white/50">
          &copy; {currentYear} Asociación Diversidad Funcional Mataró
        </p>
        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
          <a href="/privacidad" class="text-sm text-white/60 transition-colors hover:text-white/90">
            Privacidad
          </a>
          <span class="text-white/30">|</span>
          <a
            href="/eliminacion-datos"
            class="text-sm text-white/60 transition-colors hover:text-white/90"
          >
            Eliminación de datos
          </a>
        </div>
        <p class="text-sm text-white/40">
          Hecho con <span class="text-red-400">&#9829;</span> por y para la diversidad
        </p>
      </div>
    </div>
  </div>

  <!-- Línea decorativa inferior — cierre visual -->
  <div class="h-1 bg-gradient-to-r from-primary-400 via-accent-400 to-primary-400 opacity-50"></div>
</footer>

<style>
  /* ═══ Social icons — hover individual con color de marca ═══ */
  .social-icon {
    @apply flex h-14 w-14 items-center justify-center rounded-xl border border-white/20 bg-white/10 text-white/70 backdrop-blur-sm transition-all duration-300;
  }

  .social-facebook:hover {
    @apply border-blue-400/50 bg-blue-500/20 text-blue-300 shadow-lg shadow-blue-500/20;
  }

  .social-instagram:hover {
    @apply border-pink-400/50 bg-pink-500/20 text-pink-300 shadow-lg shadow-pink-500/20;
  }

  .social-youtube:hover {
    @apply border-red-400/50 bg-red-500/20 text-red-300 shadow-lg shadow-red-500/20;
