---
import type { HeroImage } from '../lib/heroImages';
import { getHeroStyles } from '../lib/heroImages';

interface Props {
  image: HeroImage;
  /** Clase de gradiente personalizado (opcional) */
  gradientClass?: string;
}

const { image, gradientClass = 'from-primary-600/85 via-primary-700/75 to-accent-600/85' } =
  Astro.props;
const styles = getHeroStyles(image);

// Determinar el background-size para móvil
const mobileScale = image.mobileScale || 'cover';
const mobileBgSize =
  mobileScale === 'contain' ? 'contain' : mobileScale === 'cover' ? 'cover' : mobileScale;
---

<!-- Fondo para móvil (oculto en desktop) -->
<div
  class="hero-bg-mobile absolute inset-0 bg-no-repeat md:hidden"
  style={`background-image: url('${styles.mobileUrl}'); background-position: ${styles.mobilePosition}; background-size: ${mobileBgSize};`}
>
</div>

<!-- Fondo para desktop (oculto en móvil) -->
<div
  class="hero-bg-desktop absolute inset-0 hidden bg-cover bg-no-repeat md:block"
  style={`background-image: url('${styles.desktopUrl}'); background-position: ${styles.desktopPosition};`}
>
</div>

<!-- Overlay con gradiente -->
<div class={`absolute inset-0 bg-gradient-to-br ${gradientClass}`}></div>
