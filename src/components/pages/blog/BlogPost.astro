---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogImage from '../../BlogImage.astro';
import Header from '../../sections/Header.astro';
import Footer from '../../sections/Footer.astro';
import {
  getImageSizes,
  getImageSrcSet,
  isCloudinarySource,
  resolveImageSrc,
} from '../../../lib/cloudinary';
import { transformCloudinaryHtml } from '../../../lib/cloudinary-html';
import { transformYouTubeHtml } from '../../../lib/youtube-html';
import { getSocialImageMeta } from '../../../lib/getSocialImage';
import {
  blogPath,
  categoryPath,
  getPublishedPosts,
  getTranslations,
  localizeArticleLinks,
  postAlternates,
  postLang,
  postPath,
  type BlogPost,
} from '../../../lib/blog';
import {
  categoryName,
  createTranslator,
  dateLocales,
  getLangFromUrl,
  langAttr,
  localizePath,
} from '../../../i18n';
import { blog } from '../../../i18n/blog';
import { render } from 'astro:content';

interface Props {
  post: BlogPost;
}

const lang = getLangFromUrl(Astro.url);
const t = createTranslator(blog, lang);
const { post } = Astro.props;
const { Content } = await render(post);
const translations = await getTranslations();
const contentLang = langAttr(postLang(post), lang);
const transformedHtml = post.rendered?.html
  ? transformYouTubeHtml(transformCloudinaryHtml(post.rendered.html))
  : null;
// En el blog catalán, los enlaces internos llevan a la versión catalana si existe
const articleHtml =
  transformedHtml && lang === 'ca'
    ? localizeArticleLinks(transformedHtml, translations)
    : transformedHtml;
const alternates = postAlternates(post, translations);

const currentId = post.id;

// URL canónica para compartir: sin barra final, que es la que el servidor sirve sin redirigir
const canonicalUrl = new URL(postPath(post), Astro.site || 'https://divermataro.org').href;

// Imagen para redes sociales: AVIF no es compatible con la mayoría de crawlers OG
const socialImageMeta = getSocialImageMeta(post.data.heroImage);

// Datos estructurados para Google: el artículo y su ruta de navegación
const siteUrl = Astro.site?.href ?? 'https://divermataro.org/';
const organization = {
  '@type': 'Organization',
  name: 'DiverMataró',
  alternateName: 'Asociación Diversidad Funcional Mataró',
  url: new URL('/', siteUrl).href,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/favicondivermataro.png', siteUrl).href,
    width: 512,
    height: 512,
  },
};
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    inLanguage: postLang(post),
    ...(socialImageMeta.src && { image: [new URL(socialImageMeta.src, siteUrl).href] }),
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    ...(post.data.category && { articleSection: post.data.category }),
    author: organization,
    publisher: organization,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: t('post.breadcrumbHome'),
        item: new URL(localizePath('/', lang), siteUrl).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: new URL(blogPath(lang), siteUrl).href,
      },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl },
    ],
  },
];
// «<» escapado para que un título nunca pueda cerrar la etiqueta <script>
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

// Obtener posts relacionados (solo los ya publicados)
const allPosts = await getPublishedPosts(lang);

const relatedPosts = allPosts
  .filter((p: BlogPost) => p.id !== currentId)
  .sort((a: BlogPost, b: BlogPost) => {
    // Priorizar misma categoría
    if (
      post.data.category &&
      a.data.category === post.data.category &&
      b.data.category !== post.data.category
    ) {
      return -1;
    }
    if (
      post.data.category &&
      a.data.category !== post.data.category &&
      b.data.category === post.data.category
    ) {
      return 1;
    }
    // Luego por fecha
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  })
  .slice(0, 3);
---

<BaseLayout
  title={`${post.data.title} - ${t('post.titleSuffix')}`}
  description={post.data.description}
  ogImage={socialImageMeta.src}
  ogImageAlt={post.data.title}
  ogImageType={socialImageMeta.type}
  ogImageWidth={socialImageMeta.width}
  ogImageHeight={socialImageMeta.height}
  canonicalUrl={canonicalUrl}
  ogLocale={postLang(post) === 'ca' ? 'ca_ES' : undefined}
  alternates={alternates}
>
  <script is:inline type="application/ld+json" set:html={jsonLdHtml} />
  <Header alternates={alternates} />
  <main id="main-content" class="min-h-screen bg-white">
    <article class="py-16 md:py-24">
      <div class="section-container">
        <div class="mx-auto max-w-4xl">
          <a
            href={blogPath(lang)}
            class="mb-8 inline-flex items-center gap-2 text-primary-600 hover:text-primary-700"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>
            {t('post.back')}
          </a>

          <header class="mb-8">
            <div class="mb-4 text-sm text-gray-500">
              {post.data.pubDate.toLocaleDateString(dateLocales[lang], {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
              {post.data.updatedDate && (
                <span class="ml-2">
                  ({t('post.updated')}{' '}
                  {post.data.updatedDate.toLocaleDateString(dateLocales[lang], {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                  )
                </span>
              )}
            </div>
            <h1 class="mb-4 text-4xl font-bold text-gray-900 md:text-5xl" lang={contentLang}>
              {post.data.title}
            </h1>
            {post.data.description && (
              <p class="mb-4 text-xl text-gray-600" lang={contentLang}>
                {post.data.description}
              </p>
            )}
            {post.data.category && (
              <a
                href={categoryPath(post.data.category, lang)}
                class="inline-block rounded-full bg-primary-100 px-4 py-2 text-sm font-semibold text-primary-700 transition-all hover:bg-primary-200 hover:shadow-md"
              >
                {categoryName(post.data.category, lang)}
              </a>
            )}
          </header>

          {post.data.heroImage && (
            <BlogImage
              src={post.data.heroImage}
              alt={post.data.title}
              lang={contentLang}
              fullOnMobile={post.data.heroFullMobile}
              transitionName={`hero-${post.id}`}
            />
          )}

          {articleHtml ? (
            <div
              class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-primary-600 hover:prose-a:text-primary-700 prose-img:rounded-xl"
              lang={contentLang}
              set:html={articleHtml}
            />
          ) : (
            <div
              class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-primary-600 hover:prose-a:text-primary-700 prose-img:rounded-xl"
              lang={contentLang}
            >
              <Content />
            </div>
          )}

          <div class="mt-12 overflow-hidden rounded-2xl border border-gray-100 bg-gradient-to-br from-gray-50 to-primary-50/30 p-6">
            <div class="mb-1 flex items-center gap-2">
              <svg
                class="h-5 w-5 text-primary-500"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                ></path>
              </svg>
              <p class="text-base font-bold text-gray-900">{t('post.share')}</p>
            </div>
            <p class="mb-5 text-sm text-gray-500">{t('post.shareText')}</p>
            <div class="grid grid-cols-4 gap-2.5">
              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-gray-400 hover:shadow-md"
                aria-label={t('post.shareX')}
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-900 text-white transition-transform duration-200 group-hover:scale-110">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">X</span>
              </a>
              <a
                href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#1877F2]/40 hover:shadow-md"
                aria-label={t('post.shareFacebook')}
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1877F2] text-white transition-transform duration-200 group-hover:scale-110">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">Facebook</span>
              </a>
              <a
                href={`https://wa.me/?text=${encodeURIComponent(post.data.title + ' ' + canonicalUrl)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-[#25D366]/40 hover:shadow-md"
                aria-label={t('post.shareWhatsApp')}
              >
                <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#25D366] text-white transition-transform duration-200 group-hover:scale-110">
                  <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"></path>
                  </svg>
                </span>
                <span class="text-xs font-semibold text-gray-700">WhatsApp</span>
              </a>
              <button
                type="button"
                id="copy-link-btn"
                data-url={canonicalUrl}
                class="group flex flex-col items-center gap-1.5 rounded-xl border border-gray-200/80 bg-white p-3 text-center shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-primary-400 hover:shadow-md"
                aria-label={t('post.copyLink')}
                data-copy={t('post.copy')}
                data-copied={t('post.copied')}
              >
                <span
                  id="copy-icon-wrapper"
                  class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-primary-500 to-accent-500 text-white transition-transform duration-200 group-hover:scale-110"
                >
                  <svg
                    id="copy-icon"
                    class="h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                    ></path>
                  </svg>
                  <svg
                    id="check-icon"
                    class="hidden h-4 w-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                  </svg>
                </span>
                <span id="copy-link-text" class="text-xs font-semibold text-gray-700">
                  {t('post.copy')}
                </span>
              </button>
            </div>
          </div>

          <script>
            const copyBtn = document.getElementById('copy-link-btn');
            const copyText = document.getElementById('copy-link-text');
            const copyIcon = document.getElementById('copy-icon');
            const checkIcon = document.getElementById('check-icon');
            const iconWrapper = document.getElementById('copy-icon-wrapper');
            if (copyBtn && copyText && copyIcon && checkIcon && iconWrapper) {
              copyBtn.addEventListener('click', () => {
                const url = copyBtn.getAttribute('data-url') || window.location.href;
                // Método sin permisos: textarea oculto + execCommand
                const ta = document.createElement('textarea');
                ta.value = url;
                ta.setAttribute('readonly', '');
                ta.style.position = 'absolute';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
                // Feedback visual
                copyIcon.classList.add('hidden');
                checkIcon.classList.remove('hidden');
                iconWrapper.classList.remove('from-primary-500', 'to-accent-500');
                iconWrapper.classList.add('from-green-500', 'to-green-600');
                copyText.textContent = copyBtn.dataset.copied ?? '';
                setTimeout(() => {
                  copyIcon.classList.remove('hidden');
                  checkIcon.classList.add('hidden');
                  iconWrapper.classList.remove('from-green-500', 'to-green-600');
                  iconWrapper.classList.add('from-primary-500', 'to-accent-500');
                  copyText.textContent = copyBtn.dataset.copy ?? '';
                }, 2000);
              });
            }
          </script>
          <script>
            // Las miniaturas de YouTube (src/lib/youtube-html.ts) se cambian por el
            // vídeo real al pulsarlas, con youtube-nocookie para no dejar cookies antes.
            document.addEventListener('click', (event) => {
              const facade = (event.target as Element).closest<HTMLButtonElement>('.yt-facade');
              if (!facade?.dataset.ytId) return;

              const iframe = document.createElement('iframe');
              iframe.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.ytId}?autoplay=1`;
              iframe.title = facade.dataset.ytTitle ?? 'Vídeo de YouTube';
              iframe.allow =
                'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
              iframe.allowFullscreen = true;
              iframe.className = facade.className.replace('yt-facade', '').trim();
              iframe.setAttribute('style', facade.getAttribute('style') ?? '');
              iframe.style.border = 'none';
              iframe.style.width ||= '100%';

              facade.replaceWith(iframe);
              iframe.focus();
            });
          </script>
          {/* Artículos relacionados */}
          {relatedPosts.length > 0 && (
            <div class="mt-16 border-t border-gray-200 pt-12">
              <h2 class="mb-8 text-2xl font-bold text-gray-900">{t('post.related')}</h2>
              <div class="grid gap-8 md:grid-cols-3">
                {relatedPosts.map((relatedPost: BlogPost) => (
                  <a href={postPath(relatedPost)} class="group block">
                    <div class="mb-4 aspect-video overflow-hidden rounded-xl bg-gray-100">
                      {relatedPost.data.heroImage ? (
                        <img
                          src={resolveImageSrc(relatedPost.data.heroImage, 'thumbnail')}
                          srcset={
                            isCloudinarySource(relatedPost.data.heroImage)
                              ? getImageSrcSet(relatedPost.data.heroImage, 'thumbnail')
                              : undefined
                          }
                          sizes={
                            isCloudinarySource(relatedPost.data.heroImage)
                              ? getImageSizes('thumbnail')
                              : undefined
                          }
                          alt={relatedPost.data.title}
                          lang={langAttr(postLang(relatedPost), lang)}
                          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-gray-400">
                          <span class="text-4xl">📄</span>
                        </div>
                      )}
                    </div>
                    <h3
                      class="line-clamp-2 text-lg font-semibold text-gray-900 transition-colors group-hover:text-primary-600"
                      lang={langAttr(postLang(relatedPost), lang)}
                    >
                      {relatedPost.data.title}
                    </h3>
                    <p
                      class="mt-2 line-clamp-2 text-sm text-gray-500"
                      lang={langAttr(postLang(relatedPost), lang)}
                    >
                      {relatedPost.data.description}
                    </p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
