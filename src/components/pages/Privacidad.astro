---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';
import PrivacidadEs from '../legal/PrivacidadEs.astro';
import PrivacidadCa from '../legal/PrivacidadCa.astro';
import { createTranslator, getLangFromUrl, localizePath } from '../../i18n';
import { legal } from '../../i18n/legal';

const lang = getLangFromUrl(Astro.url);
const t = createTranslator(legal, lang);
---

<BaseLayout title={t('privacy.title')} description={t('privacy.description')}>
  <Header />
  <main id="main-content" class="min-h-screen bg-white py-16 md:py-24">
    <div class="section-container">
      <div class="mx-auto max-w-3xl">
        <h1 class="mb-8 text-3xl font-bold text-gray-900 md:text-4xl">{t('privacy.heading')}</h1>
        <p class="mb-8 text-sm text-gray-500">{t('updated')}</p>

        <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-p:text-gray-600 prose-a:text-primary-600 hover:prose-a:text-primary-700 prose-li:text-gray-600">
          {lang === 'ca' ? <PrivacidadCa /> : <PrivacidadEs />}
        </div>

        <div class="mt-12 border-t border-gray-200 pt-8">
          <a
            href={localizePath('/', lang)}
            class="inline-flex items-center gap-2 text-primary-600 hover:text-primary-700"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"
              ></path>
            </svg>
            {t('back')}
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
