{
  "name": "astro6dm",
  // Cuenta de pago "Gusideveloper" (la misma que DiverMapa). El Account ID no es secreto.
  "account_id": "d1f835df40f3c1f57b847482a58ed772",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Workers Logs: guarda 3 días los console.error del Worker (incluido en el
  // plan gratuito). Sin esto, el fallo de Resend de 2026 solo se veía con
  // `wrangler tail` en directo.
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "divermataro.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.divermataro.org",
      "custom_domain": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "astro6dm-db",
      "database_id": "be8b651c-c5e5-47a5-87dd-37fe84287617",
    },
  ],
}
